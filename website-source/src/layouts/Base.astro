---
import '../styles/global.css';
import '../styles/structure.css';
import '../styles/disclosures.css';
import '../styles/buttons.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organization } from '../data/seo';
interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = 'The Institute for Responsible Superintelligence is an independent nonprofit research institute working on the scientific foundations of safe by design AI.',
  wide = false,
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} · RESI`
  : 'RESI | Institute for Responsible Superintelligence | AI Safety';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RESI" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={organization.logo} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1416" />
    <meta property="og:image:height" content="1111" />
    <meta property="og:image:alt" content="RESI's human and circuit logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@RESI_org" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={organization.logo} />
    <meta name="twitter:image:alt" content="RESI's human and circuit logo" />
    {isHome && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(organization).replace(/</g, '\\u003c')}
      />
    )}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/mark-resi-human-circuit.png" type="image/png" />
    <link
      rel="preload"
      href="/fonts/cardo-normal-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plex-sans-normal-100-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        const theme = localStorage.getItem('resi-theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body id="top">
    <Header />
    <main id="main" tabindex="-1" class:list={{ 'shell page-content': !wide }}>
      <slot />
    </main>
    <Footer />

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const system = window.matchMedia('(prefers-color-scheme: dark)');
      const theme = () => root.dataset.theme || (system.matches ? 'dark' : 'light');
      const label = () => {
        const next = theme() === 'dark' ? 'light' : 'dark';
        toggle?.setAttribute('aria-label', `Switch to ${next} theme`);
        toggle?.setAttribute('data-next-theme', next);
      };
      toggle?.addEventListener('click', () => {
        root.dataset.theme = theme() === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('resi-theme', root.dataset.theme);
        } catch {}
        label();
      });
      system.addEventListener('change', label);
      label();
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
      });
      // Native details supplies the accessible state. Suppress the resting hover
      // morph after a close, so a pointer left on the control sees the plus again.
      document.querySelectorAll<HTMLDetailsElement>('details.explanatory-disclosure').forEach((details) => {
        const summary = details.querySelector('summary');
        details.addEventListener('toggle', () => {
          details.toggleAttribute('data-resting-plus', !details.open);
        });
        summary?.addEventListener('pointerleave', () => details.removeAttribute('data-resting-plus'));
        summary?.addEventListener('pointerenter', () => details.removeAttribute('data-resting-plus'));
      });
      // A direct link into supplementary content opens every enclosing disclosure.
      function revealHash() {
        let id = '';
        try {
          id = decodeURIComponent(location.hash.slice(1));
        } catch {
          return;
        }
        const target = id && document.getElementById(id);
        if (!target) return;
        // Group anchors sit on headings, outside their supplementary disclosure.
        const groupDetails = target.closest('.working-group')
          ?.querySelector<HTMLDetailsElement>('details.working-group-details');
        if (groupDetails) groupDetails.open = true;
        // Paper links from People and working groups reveal the explanation too.
        const paperDetails = target.closest('.paper-entry')
          ?.querySelector<HTMLDetailsElement>('details.paper-details');
        if (paperDetails) paperDetails.open = true;
        const seminarDetails = target.closest('.seminar-list article')
          ?.querySelector<HTMLDetailsElement>('details.seminar-details');
        if (seminarDetails) seminarDetails.open = true;
        let parent: HTMLElement | null = target;
        while (parent) {
          if (parent instanceof HTMLDetailsElement) parent.open = true;
          parent = parent.parentElement;
        }
        const scrollToTarget = () => target.scrollIntoView({ behavior: 'instant' });
        if (groupDetails) {
          // Let the independently sized group columns settle before scrolling.
          requestAnimationFrame(() => requestAnimationFrame(scrollToTarget));
        } else {
          scrollToTarget();
        }
      }
      if (location.hash) revealHash();
      addEventListener('hashchange', revealHash);
      // Opening, not merely styling, guarantees initially closed content reaches print.
      let closed: HTMLDetailsElement[] = [];
      addEventListener('beforeprint', () => {
        closed = [...document.querySelectorAll<HTMLDetailsElement>('main details:not([open])')];
        closed.forEach((d) => (d.open = true));
      });
      addEventListener('afterprint', () => {
        closed.forEach((d) => (d.open = false));
        closed = [];
      });
    </script>
  </body>
</html>
