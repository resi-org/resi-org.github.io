---
import { getEntry, getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Arrow from '../../components/Arrow.astro';
import WorkshopPortrait from '../../components/WorkshopPortrait.astro';
import { workshopPortraits, workshopHostPhotoCredits } from '../../data/workshop-portraits';
import { portraitFor } from '../../lib/portraits';
import { workshopParticipantPortraits } from '../../data/workshop-participant-portraits';
import type { WorkshopPhoto } from '../../data/workshop-portraits';

// The workshop detail page shares confirmed facts with Home and Events.
const entry = await getEntry('events', '2026-12-04-inaugural-workshop');
if (!entry) throw new Error('The inaugural workshop record is missing.');
const event = entry.data;
const titleExtension = "RESI's inaugural workshop on developing scientific foundations for safer advanced AI";
const pageTitle = `${event.title}: ${titleExtension}`;
const subtitle = "RESI's inaugural workshop on developing scientific foundations for safer advanced AI, bringing together researchers from frontier labs, safety organizations, and academia.";
const speakerPhotographyCredits = event.speakers.flatMap((speaker) => {
  const credit = workshopPortraits[speaker.name].credit;
  return credit ? [{ person: speaker.name, credit }] : [];
});
const hostIds = ['shafi-goldwasser', 'adam-tauman-kalai', 'vinod-vaikuntanathan'];
const hosts = await Promise.all(hostIds.map(async (id) => {
  const person = await getEntry('people', id);
  if (!person) throw new Error(`Missing workshop host: ${id}`);
  return { name: person.data.name, portrait: portraitFor(id, person.data.photo) };
}));
const people = await getCollection('people');
const teamPortraits: Record<string, WorkshopPhoto> = Object.fromEntries(people.filter((person) => person.data.photo).map((person) => {
  const portrait = portraitFor(person.id, person.data.photo);
  return [person.data.name, { src: portrait.src!, style: portrait.style, label: 'Existing RESI People portrait' }];
}));
const participantPortraits = { ...teamPortraits, ...workshopPortraits, ...workshopParticipantPortraits };
const programNames = [...event.panels.flatMap((title) => event.panelDetails[title]?.participants.map((person) => person.name) ?? []), ...(event.spotlights?.speakers ?? [])];
for (const name of programNames) {
  if (!participantPortraits[name]) throw new Error(`Missing selected workshop portrait: ${name}`);
}
const programPhotographyCredits = programNames.flatMap((name) => {
  const credit = participantPortraits[name]?.credit;
  return credit ? [{ person: name, credit }] : [];
});
const photographyCredits = [...speakerPhotographyCredits, ...programPhotographyCredits, ...hosts.flatMap((host) => {
  const credit = workshopHostPhotoCredits[host.portrait.src ?? ''];
  return credit ? [{ person: host.name, credit }] : [];
})].filter((entry, index, credits) => credits.findIndex((item) => item.credit.id === entry.credit.id) === index);
const date = event.start.toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---

<Base
  title={pageTitle}
  description={event.overview || event.description}
>
  <article class="workshop-page">
    <header class="page-hero workshop-hero">
      <div class="workshop-heading">
        <h1><span class="title-phrase">{event.title.split(' ')[0]}</span>{' '}{event.title.split(' ').slice(1).join(' ')}</h1>
        <p class="workshop-subtitle">{subtitle}</p>
        <div class="workshop-facts" aria-label="Date, time, location and attendance">
          <span>{event.timeLabel && <>{event.timeLabel} · </>}<time datetime={event.start.toISOString().slice(0, 10)}>{date}</time></span>
          <span>{event.location}{event.attendanceLabel && <> · {event.attendanceLabel}</>}</span>
        </div>
      </div>
      {event.interestUrl && <div class="workshop-invitation">
        <p class="workshop-join-label">Join us:</p>
        <a class="workshop-interest" href={event.interestUrl} target="_blank" rel="noopener noreferrer">
          {event.interestLabel || 'Interest form'}<Arrow />
        </a>
      </div>}
      {event.interestNote && <p class="interest-note">{event.interestNote}</p>}
      <p class="program-notice">The program will be posted here. The workshop will run 9am–5pm, with check-in and breakfast starting at 8:30am.</p>
      <nav class="workshop-sections" aria-label="Workshop sections">
        <a href="#speakers">Speakers and talks</a>
        <a href="#program">Panels</a>
        <a href="#spotlights">Research spotlights</a>
      </nav>
    </header>

    <Section id="speakers" label="Speakers and talks" divider>
      <ul class="speaker-list">
        {event.speakers.map((speaker) => <li>
          <WorkshopPortrait name={speaker.name} photo={workshopPortraits[speaker.name]} />
          <h3>{speaker.name}</h3>
          {speaker.affiliation && <p class="speaker-affiliation">{speaker.affiliation}</p>}
          {speaker.talkTitle
            ? <p class="talk-title">{speaker.talkTitle}</p>
            : <p class="talk-pending">Title to be announced</p>}
        </li>)}
      </ul>
    </Section>

    <Section id="program" label="Panels" divider>
      {event.panels.length > 0 && <ul class="program-panels">
        {event.panels.map((title) => <li>
          <h3>{title}</h3>
          {event.panelDescriptions[title] && <p class="panel-description">{event.panelDescriptions[title]}</p>}
          {event.panelDetails[title] ? <>
            <ul class="participant-list">
              {event.panelDetails[title].participants.map((person) => <li>
                <div class="participant-photo"><WorkshopPortrait name={person.name} photo={participantPortraits[person.name]} square /></div>
                <p class="participant-name">{person.name}</p>
                {person.affiliation && <p class="participant-affiliation">{person.affiliation}</p>}
              </li>)}
            </ul>
            {event.panelDetails[title].moderator && <p class="program-moderator">Moderated by {event.panelDetails[title].moderator}.</p>}
          </> : <p class="program-moderator">Panelists will be announced soon.</p>}
        </li>)}
      </ul>}
    </Section>

    {event.spotlights && <Section id="spotlights" label="RESI research spotlights" divider>
      <ul class="participant-list spotlight-list">
        {event.spotlights.speakers.map((name) => <li>
          <div class="participant-photo"><WorkshopPortrait name={name} photo={participantPortraits[name]} square /></div>
          <p class="participant-name">{name}</p>
        </li>)}
      </ul>
      {event.spotlights.moderator && <p class="program-moderator">Moderated by {event.spotlights.moderator}.</p>}
    </Section>}

    <Section id="hosts" label={event.hostsLabel || 'Hosted by'} divider>
      <ul class="host-list">
        {hosts.map((host) => <li>
          <span class="host-portrait founder-portrait" style={host.portrait.style}>
            <img src={host.portrait.src} alt="" width="80" height="80" loading="lazy" decoding="async" />
          </span>
          <span class="host-name">{host.name.slice(0, host.name.lastIndexOf(' '))}{' '}<span class="host-surname">{host.name.slice(host.name.lastIndexOf(' ') + 1)}</span></span>
        </li>)}
      </ul>
    </Section>

    <div class="workshop-closing-invitation" id="join-us">
      {event.interestUrl && <div class="workshop-invitation">
        <p class="workshop-join-label">Join us:</p>
        <a class="workshop-interest" href={event.interestUrl} target="_blank" rel="noopener noreferrer">
          {event.interestLabel || 'Interest form'}<Arrow />
        </a>
      </div>}
      {event.interestNote && <p class="interest-note">{event.interestNote}</p>}
    </div>

  </article>
  {photographyCredits.length > 0 && <section slot="before-footer" class="photography-credits shell" aria-labelledby="photography-credits-heading">
    <h2 id="photography-credits-heading">Photography credits:</h2>
    <ul>
      {photographyCredits.map((entry) => <li>
        {entry.person}: {entry.credit.href
          ? <a href={entry.credit.href} target="_blank" rel="noopener noreferrer">{entry.credit.text}</a>
          : entry.credit.text}
        {entry.credit.licenseHref && <> · <a href={entry.credit.licenseHref} target="_blank" rel="noopener noreferrer">{entry.credit.licenseLabel || 'CC BY 4.0'}</a></>}
        {entry.credit.note && <> ({entry.credit.note})</>}
      </li>)}
    </ul>
  </section>}
</Base>

<style>
  .workshop-page { max-width: var(--content-width); margin-inline: auto; }
  .workshop-hero { padding-bottom: var(--section-space-before, 36px); }
  .workshop-hero h1 {
    margin: 0;
    max-width: 100%;
    /* Reuse Home's existing display-title scale, including its mobile steps. */
    font-size: clamp(31px, 6vw, 40px);
    line-height: 1.18;
    text-wrap: balance;
  }
  .title-phrase { white-space: nowrap; }
  .workshop-subtitle, .workshop-join-label {
    color: var(--muted);
    font: 400 24px/1.4 var(--sans);
  }
  .workshop-subtitle {
    font-size: 22px;
    margin: 18px 0 0;
    max-width: 100%;
    text-wrap: balance;
  }
  .workshop-closing-invitation { padding: 36px 0; }
  .workshop-invitation { display: flex; align-items: center; gap: 18px; }
  .workshop-join-label { margin: 0; }
  .workshop-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 24px;
    margin-top: 24px;
    color: var(--ink);
    font-size: 12.75px;
    font-weight: 600;
    line-height: 1.65;
  }
  .workshop-hero > .workshop-invitation { margin-top: 24px; }
  .interest-note { margin: 12px 0 0; max-width: 60ch; text-wrap: balance; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .program-notice { margin: 24px 0 0; color: var(--ink); font: 400 12.75px/1.65 var(--sans); }
  .workshop-interest {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 40px;
    padding: 10px 14px;
    border: 1px solid var(--accent);
    border-radius: 1.5px;
    background: var(--accent);
    color: var(--paper);
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
  }
  .workshop-interest:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
  .workshop-interest:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .workshop-interest :global(svg) { width: 16px; height: 16px; flex: 0 0 16px; }
  .speaker-list, .host-list { list-style: none; padding: 0; margin: 0; }
  .speaker-list {
    /* Two tracks per portrait allow centered incomplete rows. */
    display: grid; grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0 24px;
  }
  .speaker-list > li {
    grid-column: span 2; grid-row: span 4; display: grid;
    grid-template-rows: subgrid; row-gap: 0; min-width: 0;
    margin: 0; padding: 0 0 30px;
  }
  .host-list li { margin: 0; padding: 0; }
  @media (min-width: 636px) {
    .speaker-list > li:nth-child(4n + 1):last-child { grid-column: 4 / span 2; }
    .speaker-list > li:nth-child(4n + 1):nth-last-child(2) { grid-column: 3 / span 2; }
    .speaker-list > li:nth-child(4n + 1):nth-last-child(3) { grid-column: 2 / span 2; }
  }
  .speaker-list h3 { margin: 0 0 3px; font: 500 15px/1.4 var(--sans); }
  .speaker-affiliation { margin: 0; color: var(--muted); font-size: 12.75px; line-height: 1.5; }
  .talk-title, .talk-pending { margin: 9px 0 0; font: 400 12px/1.5 var(--sans); }
  .talk-title { color: var(--ink); }
  .talk-pending { color: var(--muted); }
  .workshop-sections { display: flex; flex-wrap: wrap; gap: 9px 21px; margin-top: 21px; font-size: 12px; }
  .workshop-sections a { color: var(--accent); text-underline-offset: 3px; }
  .participant-list {
    --participant-columns: 5; display: flex; flex-wrap: wrap; justify-content: center;
    gap: 21px 24px; list-style: none; padding: 0; margin: 18px 0 0;
  }
  .participant-list > li { width: calc((100% - (var(--participant-columns) - 1) * 24px) / var(--participant-columns)); min-width: 0; margin: 0; padding: 0; }
  .participant-photo { width: 80px; height: 80px; margin-bottom: 9px; }
  .participant-photo :global(.workshop-portrait) { margin: 0; }
  .participant-name { margin: 0; font: 500 12.75px/1.4 var(--sans); }
  .participant-affiliation { margin: 3px 0 0; color: var(--muted); font: 400 11.25px/1.4 var(--sans); }
  .spotlight-list { margin-top: 0; }
  .host-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; font-weight: 500; }
  .host-list li { container-type: inline-size; }
  .host-name { display: block; }
  @container (max-width: 10.1em) {
    .host-surname { display: block; }
  }
  .host-portrait { width: 80px; height: 80px; margin-bottom: 12px; }
  .photography-credits {
    max-width: var(--content-width); padding-bottom: 18px;
    color: var(--muted); font: 400 8.25px/1.65 var(--sans);
  }
  .photography-credits h2 { margin: 0 0 3px; font: inherit; }
  .photography-credits ul { margin: 0; padding: 0; list-style: none; }
  .photography-credits li { margin: 0; }
  .photography-credits a { color: inherit; }
  @media (max-width: 635px) {
    .speaker-list { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .participant-list { --participant-columns: 3; }
  }
  @media (min-width: 481px) and (max-width: 635px) {
    .speaker-list > li:nth-child(3n + 1):last-child { grid-column: 3 / span 2; }
    .speaker-list > li:nth-child(3n + 1):nth-last-child(2) { grid-column: 2 / span 2; }
  }
  @media (max-width: 600px) {
    .workshop-hero h1 { font-size: clamp(34.1px, 6.6vw, 44px); }
  }
  @media (max-width: 520px) {
    .workshop-hero h1 { font-size: clamp(29.7px, 6.875vw, 36.3px); }

  }
  .panel-description { margin: 9px 0 0; font: 400 12.75px/1.65 var(--sans); }
  .program-moderator { margin: 18px 0 0; color: var(--muted); font-size: 12.75px; line-height: 1.5; }
  .program-panels { list-style: none; padding: 0; margin: 0; display: grid; gap: 30px; }
  .program-panels li { margin: 0; }
  .program-panels h3 { margin: 0; font: 700 16.5px/1.4 var(--serif); letter-spacing: -0.005em; }
  @media (max-width: 480px) {
    .workshop-subtitle, .workshop-join-label { font-size: 21px; }
    .workshop-subtitle { font-size: 19.5px; margin-top: 15px; }
    .workshop-invitation { gap: 15px; }
    .workshop-facts { flex-direction: column; gap: 3px; margin-top: 21px; }
    .workshop-hero > .workshop-invitation { margin-top: 21px; }
    .speaker-list { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 18px; }
    .speaker-list > li { padding-bottom: 24px; }
    .speaker-list > li:nth-child(2n + 1):last-child { grid-column: 2 / span 2; }
    .speaker-list h3 { font-size: 14.25px; }
    .participant-photo { width: 67.5px; height: 67.5px; }
    .participant-name { font-size: 12px; }
    .host-list { gap: 18px; font-size: 12px; }
    .host-portrait { width: 67.5px; height: 67.5px; }
  }

  @media print {
    .speaker-list { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
</style>
