---
import { getCollection } from 'astro:content';
import { external } from '../lib/external';
import { showVisitingResearchers } from '../data/visibility';
import SectionLinks from '../components/SectionLinks.astro';
import { institute } from '../data/institute';
import { groups } from '../data/groups';
import Base from '../layouts/Base.astro';
import IntroActions from '../components/IntroActions.astro';
import PageShortcuts from '../components/PageShortcuts.astro';
import Section from '../components/Section.astro';
import Person from '../components/Person.astro';
import Founder from '../components/Founder.astro';

// Ordering follows Rachel's instructions of 2026-09-14: founding scientific
// team, research team, operations, visiting researchers,
// how to get involved, and affiliated groups (Rachel, November 5). Research-team leaders come first,
// with Chloé directly before Sam and Miranda directly before Ran
// (Rachel, 2026-10-25). Preserve the existing order within the remaining groups.
// Every group uses the same treatment, so seniority shows only in the order.
const people = await getCollection('people');
const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const founders = people.filter((p) => p.data.group === 'founders').sort(byOrder);
const leaderLinks = new Set(groups.map((g) => g.leadHref));
const leadershipRank = (p: (typeof people)[number]) =>
  leaderLinks.has('/people#' + p.id) ? 0 : 1;
const research = people
  .filter((p) => p.data.group === 'research')
  .sort((a, b) => leadershipRank(a) - leadershipRank(b) || byOrder(a, b));
for (const [personId, beforeId] of [
  ['chloe-bakalar', 'sam-gunn'],
  ['miranda-christ', 'ran-canetti'],
]) {
  const person = research.find((p) => p.id === personId);
  const before = research.find((p) => p.id === beforeId);
  if (person && before) {
    research.splice(research.indexOf(person), 1);
    research.splice(research.indexOf(before), 0, person);
  }
}
const operations = people.filter((p) => p.data.group === 'operations').sort(byOrder);
const visitors = (await getCollection('visitors')).sort(byOrder);
const affiliated = (await getCollection('affiliated')).sort(byOrder);
// Adam occupies two extra rows, so balance column height rather than name count.
const visitorSplit = Math.ceil((visitors.length - 1) / 2);
---

<Base
  title="People"
  description={`The people at RESI: the founding scientific team, the research team, operations, ${showVisitingResearchers ? 'visiting researchers, ' : ''}how to get involved, and affiliated groups.`}
>
  <header class="page-hero" id="intro">
    <p class="eyebrow">People</p>
    <h1>Concentrating expertise across disciplines</h1>
    <p>
      Participating researchers span computer science and other fields relevant to AI safety,
      including mathematics, economics and law, with an active visitor program.
    </p>

    <IntroActions
      items={[
        { label: 'Explore our research program', href: '/research' },
        { label: 'Support our work', href: '/support' },
        { label: 'Announcements', href: '/news' },
      ]}
    />
  </header>
  <PageShortcuts
    id="people-shortcuts"
    items={[
      { label: 'Founders', href: '#founders' },
      { label: 'Team', href: '#research' },
      ...(showVisitingResearchers ? [{ label: 'Visitors', href: '#visitors' }] : []),
      { label: 'Join us', href: '#get-involved' },
      { label: 'Affiliated groups', href: '#affiliated' },
    ]}
  />



  <Section divider label="Founding scientists" id="founders" class="wide" labelAbove>
    <ul class="founders-cards">
      {founders.map((p) => (
        <Founder person={p} />
      ))}
    </ul>
  </Section>

  <Section divider label="Research team" id="research">
    <ul class="people">
      {research.map((p) => (
        <Person person={p} />
      ))}
    </ul>
  </Section>

  <Section divider label="Operations" id="operations">
    <ul class="people">
      {operations.map((p) => (
        <Person person={p} />
      ))}
    </ul>
  </Section>

  {showVisitingResearchers && (
  <Section divider label="Visiting researchers" id="visitors">
    <p>
      Our visitor program keeps RESI researchers connected to frontier laboratories and the wider safety research community.
    </p>
    <span id="past-visitors" aria-hidden="true"></span>
    <ul class="compact names visitor-list">
      <li id="adam-chlipala">
        <span id="additional-leadership" aria-hidden="true"></span>
        <a href="https://adam.chlipala.net/" {...external('https://adam.chlipala.net/')}>Adam Chlipala</a>, <span class="aff">MIT</span>
        <div class="visitor-role">Leading RESI’s <a href="/research#formal-verification">Formal verification</a> working group.</div>
        <div class="visitor-agenda">
          <a href="https://www.lesswrong.com/posts/NDBbatEejiAtTAr3z/announcing-formal-verification-at-resi-the-institute-for" {...external('https://www.lesswrong.com/posts/NDBbatEejiAtTAr3z/announcing-formal-verification-at-resi-the-institute-for')}>Read the announced agenda <span aria-hidden="true">→</span></a>
        </div>
      </li>
      {visitors.map((v, index) => (
          <li style={`--visitor-column: ${index < visitorSplit - 1 ? 1 : 2}; --visitor-row: ${index < visitorSplit - 1 ? index + 4 : index - visitorSplit + 2}`}>
            {v.data.url ? (
              <a href={v.data.url} {...external(v.data.url)}>
                {v.data.name}
              </a>
            ) : (
              v.data.name
            )}
            , <span class="aff">{v.data.affiliation}</span>
          </li>
        ))}
    </ul>
  </Section>

  )}

  <Section divider label="Join us" id="get-involved">
    <div class="join-cards">
      <article class="join-card" id="work-at-resi" aria-labelledby="work-heading">
        <h3 id="work-heading">Work at RESI</h3>
        {/* Preserve the previously shared culture anchor when relocating this paragraph. */}
        <p id="culture">
          RESI’s culture is mission-first: open collaboration and early sharing of ideas. To protect
          junior researchers, we will actively support their credit and careers.
        </p>
        <p class="opportunities-note">Current opportunities — details coming.</p>
        <p class="hiring-update">
          <strong>Hiring update, <time datetime="2026-11">Nov 2026</time>:</strong>{' '}
          We anticipate application review and hiring to take place over the coming year.
        </p>
      </article>
      <article class="join-card" aria-labelledby="visit-heading">
        <h3 id="visit-heading">Visit</h3>
        <p>
          RESI hosts a small number of researchers and visitors and welcomes inquiries from researchers
          whose expertise could contribute to <a href="/research">RESI’s research</a>, whether or not
          they have previously worked on AI safety.
        </p>
        <p>
          Scientists interested in visiting can contact{' '}
          <a href="mailto:hello@resi.org">hello@resi.org</a>.
        </p>
      </article>
      <article class="join-card" aria-labelledby="reading-group-heading">
        <h3 id="reading-group-heading">AI Safety Reading Group</h3>
        <p>
          The{' '}
          <a
            href="https://resi-ai-safety.github.io/reading-group/"
            {...external('https://resi-ai-safety.github.io/reading-group/')}
          >AI safety reading group</a>{' '}
          offers an entry point into the RESI community through weekly discussions of technical
          and non-technical work on AI safety. No particular background is required.
        </p>
        <p>
          A limited number of outside guests can join each session. Complete the{' '}
          <a href="https://forms.gle/CZeYq6bm1YGoGQE18" {...external('https://forms.gle/CZeYq6bm1YGoGQE18')}>interest form</a>{' '}
          to participate.
        </p>
      </article>
      <article class="join-card" id="research-fellowships" aria-labelledby="fellowships-heading">
        <h3 id="fellowships-heading">Research fellowships across the AI safety network</h3>
        <p>Interested students may also want to explore the following programs:</p>
        <ul class="fellowship-programs">
          <li>
            <a href="https://www.cbai.ai/ais-research-fellowship" {...external('https://www.cbai.ai/ais-research-fellowship')}>CBAI</a>{' '}
            — Mentored AI safety research.
          </li>
          <li>
            <a href="https://www.matsprogram.org/apply" {...external('https://www.matsprogram.org/apply')}>MATS</a>{' '}
            — AI alignment research.
          </li>
          <li>
            <a href="https://www.pivotal-research.org/fellowships/ai-safety-fellowship" {...external('https://www.pivotal-research.org/fellowships/ai-safety-fellowship')}>Pivotal</a>{' '}
            — Funded, full-time; London.
          </li>
          <li>
            <a href="https://sparai.org/" {...external('https://sparai.org/')}>SPAR</a>{' '}
            — Remote, part-time (unpaid).
          </li>
        </ul>
      </article>
    </div>
    <SectionLinks items={[
      { label: 'Join the RESI announcements mailing list', href: institute.announcements },
      { label: 'Join announcements + weekly talks', href: institute.talks },
    ]} />
  </Section>

  <Section divider label="Affiliated groups" id="affiliated">
    <ul class="compact">
      {affiliated.map((g) => (
        <li>
          {g.data.url ? (
            <a href={g.data.url} {...external(g.data.url)}>
              {g.data.name}
            </a>
          ) : (
            g.data.name
          )}
        </li>
      ))}
    </ul>
  </Section>


</Base>

<style>
  .join-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 21px;
  }
  .join-card {
    min-width: 0;
    padding: 21px;
    border: 0.75px solid var(--line);
    border-radius: 2.25px;
  }
  .join-card h3 {
    margin: 0 0 12px;
  }
  .join-card p + p {
    margin-top: 12px;
  }
  .join-card > :last-child {
    margin-bottom: 0;
  }
  .hiring-update strong {
    display: inline;
    margin: 0;
    font-weight: 500;
  }
  .opportunities-note {
    color: var(--muted);
  }
  .fellowship-programs {
    margin-top: 12px;
    padding-left: 18px;
  }
  .fellowship-programs li + li {
    margin-top: 7.5px;
  }
  @media (min-width: 570.01px) {
    #research-fellowships {
      grid-column: 1;
      grid-row: 2;
    }
    .join-card[aria-labelledby="reading-group-heading"] {
      grid-column: 2;
      grid-row: 2;
    }
  }
  @media (max-width: 570px) {
    .join-cards {
      grid-template-columns: 1fr;
    }
    .join-card {
      padding: 16.5px;
    }
  }

  #adam-chlipala { margin-bottom: 15px; }
  @media (min-width: 480.75px) {
    .visitor-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(1.65em, auto);
      gap: 7.5px 31.5px;
    }
    .visitor-list > li {
      margin: 0;
      grid-column: var(--visitor-column);
      grid-row: var(--visitor-row);
    }
    /* Adam's details occupy three rows; the right column fills those rows normally. */
    .visitor-list > #adam-chlipala {
      margin: 0;
      grid-column: 1;
      grid-row: 1 / span 3;
    }
  }
  .visitor-role { margin-top: 4.5px; }
  .visitor-agenda { margin-top: 2.25px; }
  .visitor-role, .visitor-agenda {
    color: var(--muted);
    font-size: 10.5px;
    line-height: 1.5;
  }
</style>
