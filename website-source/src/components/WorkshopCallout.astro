---
import Arrow from './Arrow.astro';
import type { EventEntry } from '../lib/announcements';
interface Props {
  integrated?: boolean;
  event: EventEntry;
}
const { integrated = false, event } = Astro.props;
const headingId = `${event.anchor || event.id}-heading`;
const calendarDate = event.start;
const month = calendarDate.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
const dateLabel = calendarDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const Heading = integrated ? 'h3' : 'h2';
---

<aside class="announcement-item workshop-card" aria-labelledby={headingId}>
  <p class="workshop-kicker">Events{event.announcementLabel && ` · ${event.announcementLabel}`}</p>
  <time class="workshop-date" datetime={calendarDate.toISOString().slice(0, 10)} aria-label={dateLabel}>
    <span>{month}</span>
    <strong>{calendarDate.getUTCDate()}</strong>
    <span>{calendarDate.getUTCFullYear()}</span>
  </time>
  <div class="workshop-description">
    <Heading id={headingId}><a class="workshop-title-link" href={`/events#${event.anchor || event.id}`}>{event.title}</a></Heading>
    <p class="workshop-detail">{event.location}</p>
  </div>
  {event.description && <p class="workshop-summary">{event.description}</p>}
  {event.interestUrl && <a
    class="workshop-link"
    href={event.interestUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    {event.interestLabel || 'Interest form'} <Arrow />
  </a>}
</aside>

<style>
  /* Share the news cards' shape and padding; use the site's established
     card outline with a slightly stronger fill for the upcoming event. */
  .workshop-card {
    width: 100%;
    margin: 0;
    background: color-mix(in srgb, var(--accent) 14%, var(--paper));
    border: 0.75px solid var(--line);
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    gap: 12px 18px;
    font-family: var(--sans);
  }

  .workshop-kicker {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 11.25px;
    line-height: 1.5;
    font-weight: 400;
    color: var(--muted);
  }

  .workshop-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--accent);
    padding-right: 12px;
  }

  .workshop-date span {
    font: 500 10px/1.4 var(--sans);
    letter-spacing: .09em;
  }

  .workshop-date strong {
    font: 400 32px/1.08 var(--serif);
  }

  .workshop-card :is(h2, h3) {
    font: 700 18px/1.4 var(--serif);
    letter-spacing: -.01em;
    margin: 0;
    text-wrap: pretty;
  }

  .workshop-title-link { color: inherit; text-decoration: none; }
  .workshop-title-link:hover { text-decoration: underline; }

  .workshop-detail {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 11.25px;
    line-height: 1.5;
  }

  .workshop-summary {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 12.75px;
    line-height: 1.65;
  }

  .workshop-link {
    grid-column: 2;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 40px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
    background: var(--accent);
    color: var(--paper);
    padding: 10px 14px;
    border: 1px solid var(--accent);
    border-radius: 1.5px;
  }

  .workshop-link :global(svg) {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .workshop-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .workshop-link:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (max-width: 600px) {
    .workshop-card {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: 16px;
    }
    .workshop-date {
      padding-right: 12px;
    }
    .workshop-card :is(h2, h3) {
      font-size: 18px;
    }
    .workshop-link {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
