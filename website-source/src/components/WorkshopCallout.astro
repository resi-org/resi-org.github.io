---
import Arrow from './Arrow.astro';
interface Props {
  integrated?: boolean;
}
const { integrated = false } = Astro.props;
const Heading = integrated ? 'h3' : 'h2';
---

<aside class="announcement-item workshop-card" aria-labelledby="workshop-heading">
  <p class="workshop-kicker">Save the date · Inaugural community workshop</p>
  <time class="workshop-date" datetime="2026-12-04" aria-label="December 4, 2026">
    <span>DEC</span>
    <strong>4</strong>
    <span>2026</span>
  </time>
  <div class="workshop-description">
    <Heading id="workshop-heading">Safe-by-Design Superintelligence</Heading>
    <p class="workshop-detail">Cambridge, MA</p>
  </div>
  <a
    class="workshop-link"
    href="https://forms.gle/bepnqhw2Q8eGK2bB8"
    target="_blank"
    rel="noopener noreferrer"
  >
    Interest form <Arrow />
  </a>
</aside>

<style>
  /* Share the news cards' shape and padding; use the site's established
     card outline with a slightly stronger fill for the upcoming event. */
  .workshop-card {
    width: 100%;
    margin: 0;
    background: color-mix(in srgb, var(--accent) 14%, var(--paper));
    border: 0.75px solid var(--line);
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 18px;
    font-family: var(--sans);
  }

  .workshop-kicker {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 11.25px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--accent);
  }

  .workshop-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--accent);
    border-right: 0.75px solid var(--line);
    padding-right: 16px;
  }

  .workshop-date span {
    font: 500 10px/1.4 var(--sans);
    letter-spacing: .09em;
  }

  .workshop-date strong {
    font: 400 36px/1.08 var(--serif);
  }

  .workshop-card :is(h2, h3) {
    font: 700 20px/1.25 var(--serif);
    letter-spacing: -.01em;
    margin: 0;
    text-wrap: pretty;
  }

  .workshop-detail {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 11.25px;
    line-height: 1.5;
  }

  .workshop-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 40px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
    background: var(--accent);
    color: var(--paper);
    padding: 10px 14px;
    border: 1px solid var(--accent);
    border-radius: 1.5px;
  }

  .workshop-link :global(svg) {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .workshop-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .workshop-link:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (max-width: 600px) {
    .workshop-card {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: 16px;
    }
    .workshop-date {
      padding-right: 12px;
      align-self: start;
    }
    .workshop-card :is(h2, h3) {
      font-size: 19px;
    }
    .workshop-link {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
