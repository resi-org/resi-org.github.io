---
import Arrow from './Arrow.astro';
import DisclosureControl from './DisclosureControl.astro';
import type { EventEntry } from '../lib/announcements';
interface Props {
  integrated?: boolean;
  headingId?: string;
  featured?: boolean;
  /** Confirmed lineup: 'full' lists speakers with affiliations plus hosts below the
   *  summary (Events); 'names' is Home's compact form: speaker names in place of the
   *  summary, plus a "Learn more" link to the full Events entry. Omit for neither. */
  lineup?: 'full' | 'names';
  event: EventEntry;
}
const { integrated = false, featured = false, lineup, event, headingId: customHeadingId } = Astro.props;
const headingId = customHeadingId || `${event.anchor || event.id}-heading`;
const calendarDate = event.start;
const month = calendarDate.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
const dateLabel = calendarDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const Heading = integrated ? 'h3' : 'h2';
const isUpcoming = event.timing === 'upcoming';
const labels = isUpcoming
  ? event.announcementLabel?.split(' · ') || []
  : [event.pastAnnouncement?.label || 'Past event'];
// The lineup is part of the upcoming invitation; past cards keep their approved quiet treatment.
const lineupGroups = lineup === 'full' && isUpcoming
  ? [
      { key: 'speakers', label: event.speakersLabel || 'Speakers', people: event.speakers },
      { key: 'hosts', label: event.hostsLabel || 'Hosted by', people: event.hosts.map((name) => ({ name, affiliation: undefined })) },
    ].filter((group) => group.people.length > 0)
  : [];
const speakerNames = lineup === 'names' && isUpcoming ? event.speakers.map((speaker) => speaker.name) : [];
const detailsHref = event.detailsHref || `/events#${event.anchor || event.id}`;
// Home cards are compact, so they offer a visible path to the full Events entry.
const showMore = lineup === 'names' && isUpcoming;
---

<aside class:list={['announcement-item', 'workshop-card', { 'past-event': !isUpcoming, 'featured-event': featured }]} aria-labelledby={headingId}>
  <slot name="heading" />
  <p class="announcement-meta workshop-kicker">
    {!featured && <span>Events</span>}
    {labels.filter(label => !featured || label !== 'Save the date').map(label => <span class:list={{ 'workshop-save-date': label === 'Save the date' }}>{label}</span>)}
  </p>
  <time class="workshop-date" datetime={calendarDate.toISOString().slice(0, 10)} aria-label={dateLabel}>
    <span>{month}</span>
    <strong>{calendarDate.getUTCDate()}</strong>
    <span>{calendarDate.getUTCFullYear()}</span>
  </time>
  <div class="workshop-main">
    <div class="workshop-description">
      <Heading id={headingId}><a class="workshop-title-link" href={detailsHref}>{event.title.split(/\s+/).map((word, index) => <>{index > 0 && ' '}<span>{word}</span></>)}</a></Heading>
      {isUpcoming && <p class="workshop-detail">{event.location}</p>}
    </div>
    {isUpcoming && event.interestUrl && <div class="workshop-action">
      <a class="workshop-link" href={event.interestUrl} target="_blank" rel="noopener noreferrer">
        {event.interestLabel || 'Interest form'} <Arrow />
      </a>
    </div>}
  </div>
  {event.description && speakerNames.length === 0 && <p class="workshop-summary">{event.description}</p>}
  {lineupGroups.length > 0 && <div class="workshop-lineup">
    {lineupGroups.map((group) => (
      <div class="workshop-lineup-group" data-group={group.key}>
        <p class="workshop-lineup-label" id={`${headingId}-${group.key}`}>{group.label}</p>
        <ul class="workshop-lineup-list" aria-labelledby={`${headingId}-${group.key}`}>
          {group.people.map((person) => <li><span class="workshop-lineup-name">{person.name}</span>{person.affiliation && <span>, {person.affiliation}</span>}</li>)}
        </ul>
      </div>
    ))}
  </div>}
  {speakerNames.length > 0 && <p class="workshop-lineup workshop-lineup-names">
    <span class="workshop-lineup-label">{event.speakersLabel || 'Speakers'}</span>
    {speakerNames.map((name, index) => <><span class="workshop-lineup-name">{name}</span>{index < speakerNames.length - 1 && ', '}</>)}
  </p>}
  {showMore && <a class="workshop-more" href={detailsHref} aria-label={`Learn more about ${event.title}`}><span>Learn more</span><Arrow /></a>}
  {!isUpcoming && <details class="past-event-details explanatory-disclosure">
    <summary aria-label={`Event details for ${event.title}`}><DisclosureControl /></summary>
    <div class="past-event-logistics">
      <h4>Event details</h4>
      <p class="workshop-detail">{event.location}</p>
    </div>
  </details>}
</aside>

<style>
  /* Keep the news-card fill, radius and padding; emphasize the event through
     the existing hairline outline treatment and its compact calendar. */
  .workshop-card {
    --workshop-title-size: 22px;
    container-type: inline-size;
    width: 100%;
    margin: 0;
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
    border: 0.75px solid color-mix(in srgb, var(--accent) 60%, var(--paper));
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: start;
    gap: 12px 18px;
    font-family: var(--sans);
  }

  .workshop-kicker {
    flex-wrap: nowrap;
    white-space: nowrap;
    grid-column: 1 / -1;
    margin: 0;
    font-size: 11.25px;
    line-height: 1.65;
    font-weight: 700;
    color: var(--accent);
  }

  @container (width < 315px) {
    .workshop-save-date {
      display: none;
    }
  }

  .workshop-kicker > span:first-child::before {
    content: none;
  }

  .workshop-main {
    align-self: center;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 18px;
  }

  /* The calendar centers on the text, independently of the button's height. */
  .workshop-action {
    block-size: 0;
    inline-size: max-content;
  }

  .workshop-date {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--accent);
    padding-right: 12px;
  }

  .workshop-date span {
    font: 500 10px/1.4 var(--sans);
    letter-spacing: .09em;
  }

  .workshop-date strong {
    font: 400 32px/1.08 var(--serif);
  }

  .workshop-card :is(h2, h3) {
    font: 700 var(--workshop-title-size)/1.25 var(--serif);
    text-box: trim-both cap alphabetic;
    letter-spacing: -.01em;
    margin: 0;
    text-wrap: pretty;
  }

  .workshop-description {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, calc(10px + (100cqi - 540px) * .3), 16.5px);
  }

  .workshop-card :is(h2, h3) span {
    white-space: nowrap;
  }

  .workshop-title-link { color: inherit; text-decoration: none; }
  .workshop-title-link:hover { text-decoration: underline; }

  .workshop-detail {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
    text-box: trim-both cap alphabetic;
    padding-bottom: .2em;
  }

  .workshop-summary {
    grid-column: 1 / -1;
    grid-row: 3;
    margin: 0;
    color: var(--muted);
    font-size: 12.75px;
    line-height: 1.65;
  }

  /* Confirmed lineup below the summary, in the card's existing type scale. */
  .workshop-lineup {
    grid-column: 1 / -1;
    grid-row: 4;
    display: grid;
    gap: 12px;
    padding-top: 12px;
    border-top: 0.75px solid color-mix(in srgb, var(--accent) 30%, var(--paper));
    color: var(--muted);
    font-size: 12.75px;
    line-height: 1.65;
  }

  .workshop-lineup-label {
    margin: 0 0 3px;
    font-size: 11.25px;
    font-weight: 700;
    color: var(--accent);
  }

  .workshop-lineup-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 2px 18px;
  }

  .workshop-lineup-list li {
    margin: 0;
    padding: 0;
  }

  /* Hosts carry no affiliation, so three fit across where speakers take two. */
  .workshop-lineup-group[data-group="hosts"] .workshop-lineup-list {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr));
  }

  .workshop-lineup-name {
    color: var(--ink);
    font-weight: 500;
  }

  /* Home's compact form: one label and a run of names in place of the
     summary, so the card keeps its approved height and row structure. */
  .workshop-lineup-names {
    display: block;
    grid-row: 3;
    margin: 0;
    padding-top: 0;
    border-top: 0;
  }

  .workshop-lineup-names .workshop-lineup-label {
    display: block;
  }

  .workshop-lineup-names .workshop-lineup-name {
    white-space: nowrap;
  }

  .featured-event .workshop-lineup-names {
    grid-row: 4;
  }
  @media (min-width: 651px) {
    .featured-event .workshop-lineup-names .workshop-lineup-name {
      white-space: normal;
    }
  }

  /* Home's onward link to the full Events entry, in the shared underlined-label
     and arrow style. Regular cards place it under the names; the featured card
     sets it beside the action so the card gains no height. */
  .workshop-more {
    grid-column: 1 / -1;
    grid-row: 4;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    line-height: 1.65;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .workshop-more span {
    text-decoration: underline;
    text-decoration-thickness: 0.75px;
    text-underline-offset: 0.2em;
  }

  .workshop-more :global(svg) {
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  .workshop-more:focus-visible {
    outline: 1.5px solid var(--accent);
    outline-offset: 3px;
    border-radius: 1.5px;
  }

  .workshop-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 40px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
    background: var(--accent);
    color: var(--paper);
    padding: 10px 14px;
    border: 1px solid var(--accent);
    border-radius: 1.5px;
  }

  .workshop-link :global(svg) {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .workshop-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .workshop-link:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @supports not (text-box: trim-both cap alphabetic) {
    .workshop-action {
      padding-block-start: calc(var(--workshop-title-size) * .25);
    }
  }

  @media (max-width: 480px) {
    .workshop-card {
      --workshop-title-size: 20px;
      grid-template-columns: 36px minmax(0, 1fr);
      column-gap: 12px;
    }
    .workshop-main {
      column-gap: 12px;
      align-self: end;
      margin-bottom: 2px;
    }
    .workshop-description {
      gap: 13px;
    }
    .workshop-detail {
      transform: translateY(1px);
    }
    .workshop-date {
      padding-right: 0;
    }
    .workshop-date strong {
      font-size: 34px;
      margin-block: 1px;
    }
    .workshop-link {
      font-size: 11.5px;
      gap: 8px;
      padding: 8px;
    }
    .workshop-link :global(svg) {
      width: 14px;
      height: 14px;
      flex-basis: 14px;
    }
  }

  @media (max-width: 380px) {
    .workshop-card {
      --workshop-title-size: 18px;
      grid-template-columns: 28px minmax(0, 1fr);
      column-gap: 8px;
    }
    .workshop-main {
      column-gap: 8px;
    }
    .workshop-date strong {
      line-height: 1.04;
      margin-block: .5px;
    }
    .workshop-date span:first-child {
      transform: translateY(1px);
    }
    .workshop-link {
      font-size: 11px;
    }
    .workshop-link :global(svg) {
      display: none;
    }
  }

  /* The preview's side column gives the action its own natural row. */
  .workshop-card.featured-event {
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 18px 12px;
    padding: 20px 16px;
  }
  .featured-event .workshop-kicker {
    grid-row: 2;
    gap: 0;
    white-space: normal;
    flex-wrap: wrap;
  }
  .featured-event .workshop-main {
    display: contents;
  }
  .featured-event .workshop-description {
    grid-row: 3;
    grid-column: 2;
    --workshop-title-size: 20px;
    align-self: center;
    gap: 12px;
  }
  .featured-event .workshop-action {
    grid-column: 1 / -1;
    grid-row: 5;
    block-size: auto;
    inline-size: auto;
    padding: 0;
  }
  .featured-event .workshop-more {
    grid-row: 5;
    justify-self: end;
    align-self: center;
  }
  /* Too narrow for both on one line: the link takes its own row. */
  @container (width < 232px) {
    .featured-event .workshop-more {
      grid-row: 6;
      justify-self: start;
    }
  }
  .featured-event .workshop-summary {
    grid-row: 4;
  }
  .featured-event .workshop-date {
    grid-row: 3;
    grid-column: 1;
    padding-right: 0;
  }
  .featured-event .workshop-link {
    padding: 10px 14px;
    font-size: 12px;
  }
  @media (max-width: 480px) {
    .workshop-card.featured-event {
      padding: 20px 18px;
      gap: 18px 14px;
      grid-template-columns: 36px minmax(0, 1fr);
    }
  }

  @container (width < 220px) {
    .workshop-card.featured-event {
      grid-template-columns: 28px minmax(0, 1fr);
      column-gap: 10px;
      padding: 18px 14px;
    }
    .featured-event .workshop-description {
      --workshop-title-size: 18px;
    }
  }

  @media (max-width: 520px) {
    /* Match the normal card rhythm; keep the feature heading and label close. */
    .workshop-card.featured-event { row-gap: 10px; }
    .featured-event .workshop-kicker { margin-top: -4px; }
  }

  @media (min-width: 521px) {
    .workshop-card.featured-event {
      padding-block: 16px;
      row-gap: 10px;
      grid-template-rows: repeat(5, max-content);
      align-content: space-between;
    }
  }

  /* Past events keep their calendar/title treatment; logistics are revealed
     only at the bottom, consistently with the past-seminar archive. */
  .workshop-card.past-event {
    --workshop-title-size: 16.5px;
    border: 0;
  }
  .past-event .workshop-kicker {
    font-weight: 400;
    color: var(--muted);
  }
  .past-event .workshop-date {
    color: var(--muted);
  }
  .past-event .workshop-main {
    grid-template-columns: minmax(0, 1fr);
    align-self: center;
    margin-bottom: 0;
  }
  .past-event :is(h2, h3) {
    line-height: 1.4;
  }
  .past-event .workshop-description {
    gap: 10px;
  }
  .past-event .workshop-detail {
    font-size: 11.25px;
    line-height: 1.65;
    transform: none;
  }
  .past-event-details {
    grid-column: 1 / -1;
    margin: 0;
  }
  .past-event-details > summary {
    display: flex;
    justify-content: flex-end;
    min-height: 33px;
    color: var(--accent);
    cursor: pointer;
  }
  .past-event-details > summary:focus-visible {
    outline: 1.5px solid var(--accent);
    outline-offset: 3px;
    border-radius: 1.5px;
  }
  .past-event-logistics h4 {
    margin: 15px 0 7.5px;
    font: 600 12.75px/1.5 var(--sans);
  }
  .past-event .workshop-title-link {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
