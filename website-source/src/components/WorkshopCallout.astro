---
import Arrow from './Arrow.astro';
import type { EventEntry } from '../lib/announcements';
interface Props {
  integrated?: boolean;
  event: EventEntry;
}
const { integrated = false, event } = Astro.props;
const headingId = `${event.anchor || event.id}-heading`;
const calendarDate = event.start;
const month = calendarDate.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
const dateLabel = calendarDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const Heading = integrated ? 'h3' : 'h2';
---

<aside class="announcement-item workshop-card" aria-labelledby={headingId}>
  <p class="announcement-meta workshop-kicker">
    <span>Events</span>
    {event.announcementLabel?.split(' · ').map(label => <span>{label}</span>)}
  </p>
  <time class="workshop-date" datetime={calendarDate.toISOString().slice(0, 10)} aria-label={dateLabel}>
    <span>{month}</span>
    <strong>{calendarDate.getUTCDate()}</strong>
    <span>{calendarDate.getUTCFullYear()}</span>
  </time>
  <div class="workshop-main">
    <div class="workshop-description">
      <Heading id={headingId}><a class="workshop-title-link" href={`/events#${event.anchor || event.id}`}>{event.title.split(/\s+/).map((word, index) => <>{index > 0 && ' '}<span>{word}</span></>)}</a></Heading>
      <p class="workshop-detail">{event.location}</p>
    </div>
    {event.interestUrl && <div class="workshop-action">
      <a class="workshop-link" href={event.interestUrl} target="_blank" rel="noopener noreferrer">
        {event.interestLabel || 'Interest form'} <Arrow />
      </a>
    </div>}
  </div>
  {event.description && <p class="workshop-summary">{event.description}</p>}
</aside>

<style>
  /* Keep the news-card fill, radius and padding; emphasize the event through
     the existing hairline outline treatment and its compact calendar. */
  .workshop-card {
    --workshop-title-size: 22px;
    width: 100%;
    margin: 0;
    background: color-mix(in srgb, var(--accent) 10%, var(--paper));
    border: 0.75px solid color-mix(in srgb, var(--accent) 60%, var(--paper));
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: start;
    gap: 12px 18px;
    font-family: var(--sans);
  }

  .workshop-kicker {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 11.25px;
    line-height: 1.65;
    font-weight: 700;
    color: var(--accent);
  }

  .workshop-kicker > span:first-child::before {
    content: none;
  }

  .workshop-main {
    align-self: center;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 18px;
  }

  /* The calendar centers on the text, independently of the button's height. */
  .workshop-action {
    block-size: 0;
    inline-size: max-content;
  }

  .workshop-date {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--accent);
    padding-right: 12px;
  }

  .workshop-date span {
    font: 500 10px/1.4 var(--sans);
    letter-spacing: .09em;
  }

  .workshop-date strong {
    font: 400 32px/1.08 var(--serif);
  }

  .workshop-card :is(h2, h3) {
    font: 700 var(--workshop-title-size)/1.25 var(--serif);
    text-box: trim-both cap alphabetic;
    letter-spacing: -.01em;
    margin: 0;
    text-wrap: pretty;
  }

  .workshop-description {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .workshop-card :is(h2, h3) span {
    white-space: nowrap;
  }

  .workshop-title-link { color: inherit; text-decoration: none; }
  .workshop-title-link:hover { text-decoration: underline; }

  .workshop-detail {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
    text-box: trim-both cap alphabetic;
    padding-bottom: .2em;
  }

  .workshop-summary {
    grid-column: 1 / -1;
    grid-row: 3;
    margin: 0;
    color: var(--muted);
    font-size: 12.75px;
    line-height: 1.65;
  }

  .workshop-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 40px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
    background: var(--accent);
    color: var(--paper);
    padding: 10px 14px;
    border: 1px solid var(--accent);
    border-radius: 1.5px;
  }

  .workshop-link :global(svg) {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .workshop-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .workshop-link:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @supports not (text-box: trim-both cap alphabetic) {
    .workshop-action {
      padding-block-start: calc(var(--workshop-title-size) * .25);
    }
  }

  @media (max-width: 480px) {
    .workshop-card {
      --workshop-title-size: 20px;
      grid-template-columns: 36px minmax(0, 1fr);
      column-gap: 12px;
    }
    .workshop-main {
      column-gap: 12px;
      align-self: end;
      margin-bottom: 2px;
    }
    .workshop-description {
      gap: 13px;
    }
    .workshop-detail {
      transform: translateY(1px);
    }
    .workshop-date {
      padding-right: 0;
    }
    .workshop-date strong {
      font-size: 34px;
      margin-block: 1px;
    }
    .workshop-link {
      font-size: 11.5px;
      gap: 8px;
      padding: 8px;
    }
    .workshop-link :global(svg) {
      width: 14px;
      height: 14px;
      flex-basis: 14px;
    }
  }

  @media (max-width: 380px) {
    .workshop-card {
      --workshop-title-size: 18px;
      grid-template-columns: 28px minmax(0, 1fr);
      column-gap: 8px;
    }
    .workshop-main {
      column-gap: 8px;
    }
    .workshop-link {
      font-size: 11px;
    }
    .workshop-link :global(svg) {
      display: none;
    }
  }
</style>
