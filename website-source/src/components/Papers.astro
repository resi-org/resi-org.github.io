---
import { getCollection } from 'astro:content';
import { external } from '../lib/external';
import { linkAuthors } from '../lib/researchers';
import { publicationVenue } from '../lib/publication-display';

// Title first, then concise venue and full authors; research explanations stay separate.
interface Props {
  placement: string | string[];
  showAttribution?: boolean;
}
const { placement, showAttribution = true } = Astro.props;
const placements = Array.isArray(placement) ? placement : [placement];
const papers = (await getCollection('selectedResearch'))
  .filter((p) => placements.includes(p.data.placement))
  .sort((a, b) => a.data.order - b.data.order);
const rows = await Promise.all(
  papers.map(async (p) => {
    const highlightText = [p.data.highlight?.summary, p.data.highlight?.caveat]
      .filter(Boolean)
      .join(' ');
    return {
      p,
      authors: await linkAuthors(p.data.authors),
      showNote: !highlightText.includes(p.data.note),
      showLimitation: p.data.limitation && !highlightText.includes(p.data.limitation),
    };
  }),
);
---

{rows.length > 0 && (
  <ul class="rows papers">
    {rows.map(({ p, authors, showNote, showLimitation }) => (
      <li id={p.data.anchor} class="paper-entry">
        {/* Previously shared area links still reach the relevant work. */}
        {p.data.anchor === 'computational-barriers-to-filtering-for-ai-alignment' && (
          <span id="limits" />
        )}
        {p.data.anchor === 'pseudorandom-error-correcting-codes' && <span id="cryptography" />}
        <div class="row-link">
          {showAttribution && <span class="paper-relationship">Prior work</span>}
          <h3 class="paper-title-line">
            <a class="row-title" href={p.data.url} {...external(p.data.url)}>
              {p.data.title}
            </a>
          </h3>
          <div class="paper-information">
            <div class="paper-bibliography">
              {p.data.venue && <div class="row-meta paper-venue">{publicationVenue(p.data.venue)}</div>}
              <div class="row-meta paper-authors">
                {authors.map((part) => typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>)}
              </div>
            </div>
            <details class="paper-details">
              <summary aria-label={`Details for ${p.data.title}`}>
                Details <span class="paper-details-icon" aria-hidden="true"></span>
              </summary>
              <div class="paper-details-body">
                {p.data.conferenceNote && <div class="row-meta paper-conference-note">{p.data.conferenceNote}</div>}
                {p.data.anchor === 'data-attribution-paper' && (
                  <span class="paper-code-line"><a
                    class="text-link"
                    href="https://github.com/samuel-gunn/microgpt-sketch"
                    {...external('https://github.com/samuel-gunn/microgpt-sketch')}
                  >
                    Experimental code
                  </a></span>
                )}
                {p.data.highlight && (
                  <Fragment>
                    {p.data.highlight.id !== p.data.anchor && <span id={p.data.highlight.id} />}
                    <span class="evidence-topic">{p.data.highlight.title}</span>
                    <span class="row-note">{p.data.highlight.summary}</span>
                    {p.data.highlight.caveat && <span class="row-note">{p.data.highlight.caveat}</span>}
                  </Fragment>
                )}
                {showNote && <span class="row-note">{p.data.note}</span>}
                {showLimitation && (
                  <span class="row-note">
                    <strong>Scope.</strong> {p.data.limitation}
                  </span>
                )}
              </div>
            </details>
          </div>
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .row-link { gap: 6px; }
  .paper-title-line { margin: 0; }
  .paper-information { position: relative; }
  .paper-bibliography { padding-right: 75px; min-height: 33px; }
  .paper-venue { font-weight: 500; }
  .paper-authors, .paper-conference-note { margin-top: 3.75px; line-height: 1.5; }
  .paper-authors a { color: inherit; text-decoration: none; }
  .paper-authors a:hover, .paper-authors a:focus-visible { color: var(--accent); text-decoration: underline; }
  .paper-details { margin: 0; }
  .paper-details > summary {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: baseline;
    gap: 7.5px;
    width: fit-content;
    min-height: 33px;
    min-width: 60px;
    justify-content: flex-end;
    color: var(--accent);
    font: 400 11.25px/1.5 var(--sans);
    cursor: pointer;
    list-style: none;
  }
  .paper-details > summary::-webkit-details-marker { display: none; }
  .paper-details > summary:hover { color: var(--ink); }
  .paper-details > summary:focus-visible {
    outline: 1.5px solid var(--accent);
    outline-offset: 3px;
    border-radius: 1.5px;
  }
  .paper-details-icon::before { content: '+'; }
  .paper-details[open] .paper-details-icon::before { content: '−'; }
  .paper-details-icon { font-size: 16.5px; }
  .paper-details-body {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 15px 0 3px;
    max-width: 66ch;
  }
  @media print {
    .paper-details > summary { display: none; }
  }
</style>
