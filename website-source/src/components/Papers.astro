---
import { getCollection } from 'astro:content';
import DisclosureControl from './DisclosureControl.astro';
import { external } from '../lib/external';
import { linkAuthors } from '../lib/researchers';
import { publicationVenue } from '../lib/publication-display';

// Title first, then concise venue and author metadata; research explanations stay separate.
interface Props {
  placement: string | string[];
  showAttribution?: boolean;
}
const { placement, showAttribution = true } = Astro.props;
const placements = Array.isArray(placement) ? placement : [placement];
const papers = (await getCollection('selectedResearch'))
  .filter((p) => placements.includes(p.data.placement))
  .sort((a, b) => a.data.order - b.data.order);
const rows = await Promise.all(
  papers.map(async (p) => {
    const highlightText = [p.data.highlight?.summary, p.data.highlight?.caveat]
      .filter(Boolean)
      .join(' ');
    const authorNames = p.data.authors.split(',').map((name) => name.trim());
    const truncatedAuthors = authorNames.length > 3;
    const displayAuthors = truncatedAuthors
      ? `${authorNames.slice(0, 3).join(', ')}, et al.`
      : p.data.authors;
    return {
      p,
      authors: await linkAuthors(displayAuthors),
      fullAuthors: truncatedAuthors ? await linkAuthors(p.data.authors) : null,
      showNote: !highlightText.includes(p.data.note),
      showLimitation: p.data.limitation && !highlightText.includes(p.data.limitation),
    };
  }),
);
---

{rows.length > 0 && (
  <ul class="rows papers">
    {rows.map(({ p, authors, fullAuthors, showNote, showLimitation }) => (
      <li id={p.data.anchor} class="paper-entry">
        {/* Previously shared area links still reach the relevant work. */}
        {p.data.anchor === 'computational-barriers-to-filtering-for-ai-alignment' && (
          <span id="limits" />
        )}
        {p.data.anchor === 'pseudorandom-error-correcting-codes' && <span id="cryptography" />}
        <div class="row-link">
          {showAttribution && <span class="paper-relationship">Prior work</span>}
          <h3 class="paper-title-line">
            <a class="row-title" href={p.data.url} {...external(p.data.url)}>
              {p.data.title}
            </a>
          </h3>
          <div class="paper-information">
            <div class="paper-citation">
            {p.data.venue && <span class="row-meta paper-venue">{publicationVenue(p.data.venue)}</span>}
            <span class="row-meta paper-authors">
              {authors.map((part) => typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>)}
            </span>
            </div>
            <details class="paper-details explanatory-disclosure">
              <summary aria-label={`Details for ${p.data.title}`}>
                <DisclosureControl />
              </summary>
              <div class="paper-details-body">
                {fullAuthors && <div class="row-meta paper-full-authors">
                  <strong>Authors.</strong>{' '}
                  {fullAuthors.map((part) => typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>)}
                </div>}
                {p.data.conferenceNote && <div class="row-meta paper-conference-note">{p.data.conferenceNote}</div>}
                {p.data.anchor === 'data-attribution-paper' && (
                  <span class="paper-code-line"><a
                    class="text-link"
                    href="https://github.com/samuel-gunn/microgpt-sketch"
                    {...external('https://github.com/samuel-gunn/microgpt-sketch')}
                  >
                    Experimental code
                  </a></span>
                )}
                {p.data.highlight && (
                  <Fragment>
                    {p.data.highlight.id !== p.data.anchor && <span id={p.data.highlight.id} />}
                    <span class="evidence-topic">{p.data.highlight.title}</span>
                    <span class="row-note">{p.data.highlight.summary}</span>
                    {p.data.highlight.caveat && <span class="row-note">{p.data.highlight.caveat}</span>}
                  </Fragment>
                )}
                {showNote && <span class="row-note">{p.data.note}</span>}
                {showLimitation && (
                  <span class="row-note">
                    <strong>Scope.</strong> {p.data.limitation}
                  </span>
                )}
              </div>
            </details>
          </div>
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .row-link { gap: 6px; }
  .paper-title-line { margin: 0; }
  .paper-venue { font-weight: 500; }
  .paper-authors { display: block; }
  .paper-authors, .paper-conference-note { margin-top: 3.75px; line-height: 1.5; }
  .paper-authors a, .paper-full-authors a { color: inherit; text-decoration: none; }
  .paper-authors a:hover, .paper-authors a:focus-visible, .paper-full-authors a:hover, .paper-full-authors a:focus-visible { color: var(--accent); text-decoration: underline; }
  .paper-details { margin: 0; }
  .paper-details > summary {
    cursor: pointer;
    list-style: none;
  }
  .paper-information { display: grid; grid-template-columns: minmax(0, 1fr) var(--disclosure-gutter, 75px); min-height: 33px; }
  .paper-citation { grid-row: 1; grid-column: 1; }
  .paper-details { position: relative; grid-row: 2; grid-column: 1 / -1; }
  /* Row 2 starts at the bottom of the citation, even when the details open.
     The mark's bottom follows the final author line, including wrapped names. */
  .paper-details > summary { position: absolute; top: calc(-18.75px - var(--disclosure-mark-size) / 2); right: 0; width: 33px; height: 33px; }
  .paper-details > summary::-webkit-details-marker { display: none; }
  .paper-details > summary:focus-visible {
    outline: 1.5px solid var(--accent);
    outline-offset: 3px;
    border-radius: 1.5px;
  }
  .paper-details-body {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 15px 0 3px;
    max-width: 66ch;
  }
  @media print {
    .paper-details > summary { display: none; }
    .paper-information { display: block; }
  }
</style>
