---
import { areas } from '../data/institute';
import { groups } from '../data/groups';
import { external } from '../lib/external';
import Disclosure from './Disclosure.astro';
interface Props {
  expanded?: boolean;
}
const { expanded = false } = Astro.props;
---

<div class={expanded ? 'research-map research-map-expanded' : 'research-question-list'}>
  {areas.map((area) => {
    const group = groups.find((item) => item.id === area.workingGroupId);
    if (area.workingGroupId && !group) {
      throw new Error(`Unknown working group for ${area.id}: ${area.workingGroupId}`);
    }
    // Promote an existing question (or opening statement) without rewriting team copy.
    const leadIndex = area.question
      ? -1
      : Math.max(
          0,
          area.paragraphs.findIndex((p: string) => p.endsWith('?')),
        );
    const lead = area.question || area.paragraphs[leadIndex] || '';
    const details = area.paragraphs.filter((_, i) => i !== leadIndex);
    const hasDetails = Boolean(
      area.detailTitle || area.description || area.example || details.length,
    );
    return (
      <article class={expanded ? 'map-item' : 'research-question-item'} id={area.id}>
        {expanded && area.id === 'delegation' && <span id="control" />}
        {expanded ? (
          <Fragment>
            <h3>{area.title}</h3>
            <div class="research-detail-body">
              {area.question && <p class="research-area-question">{area.question}</p>}
              {area.detailTitle && <h4>{area.detailTitle}</h4>}
              {area.description && <p>{area.description}</p>}
              {area.example && <p>{area.example}</p>}
              {area.paragraphs.map((text) => (
                <p>{text}</p>
              ))}
            </div>
          </Fragment>
        ) : hasDetails ? (
          <Disclosure summary={area.title} summaryLead={lead} class="research-question-dropdown">
            <div class="research-detail-body">
              {area.detailTitle && <h4>{area.detailTitle}</h4>}
              {area.description && <p>{area.description}</p>}
              {area.example && <p>{area.example}</p>}
              {details.map((text) => (
                <p>{text}</p>
              ))}
            </div>
          </Disclosure>
        ) : (
          <div class="research-question-static">
            <h3 class="research-question-title">{area.title}</h3>
            {lead && <p class="research-question-lead">{lead}</p>}
          </div>
        )}
        {group && (
          <div class="research-area-group">
            We collaborate on this area through the{' '}
            <a href={`/research#${group.id}`}>{group.name}</a> working group, led by{' '}
            <a href={group.leadHref} {...external(group.leadHref)}>{group.lead}</a>.
          </div>
        )}
      </article>
    );
  })}
</div>

<style is:global>
  /* Card content uses its own rhythm rather than prose-section heading margins. */
  @media screen {
    .research-map-expanded > .map-item {
      padding: 24px;
    }
    .research-map-expanded > .map-item > h3 {
      margin: 0 0 16px;
      /* Cardo tops out at 700; lightly strengthen the existing bold face. */
      -webkit-text-stroke: 0.25px currentColor;
    }
    .research-map-expanded .research-detail-body > p {
      margin: 0;
      line-height: 1.65;
    }
    .research-map-expanded .research-detail-body > p + p {
      margin-top: 18px;
    }
    .research-map-expanded > .map-item > .research-area-group {
      margin-top: 20px;
    }
  }
  @media screen and (max-width: 640px) {
    .research-map-expanded > .map-item {
      padding: 20px;
    }
  }
  .research-map-expanded .research-area-question {
    font-weight: 500;
  }
  .research-area-group {
    margin-top: 10px;
    font: 400 15px/1.55 var(--sans);
    color: var(--muted);
  }
  .research-question-list {
    display: grid;
    gap: 30px;
  }
  .research-question-item {
    min-width: 0;
  }
  .research-question-dropdown > summary,
  .research-question-static {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin: 0;
    padding: 4px 0;
    font: 700 22px/1.4 var(--serif);
    color: var(--ink);
    list-style: none;
  }
  .research-question-static {
    display: block;
  }
  .research-summary {
    display: block;
  }
  .research-question-title {
    display: block;
    font: 700 22px/1.4 var(--serif);
    margin: 0;
  }
  .research-question-lead {
    display: block;
    font: 400 17px/1.65 var(--sans);
    color: var(--ink);
    margin: 12px 0 0;
    max-width: 70ch;
  }
  .research-question-dropdown > summary {
    cursor: pointer;
  }
  .research-question-dropdown > summary::-webkit-details-marker {
    display: none;
  }
  .research-question-dropdown > summary::after {
    content: '+';
    flex: 0 0 auto;
    color: var(--accent);
  }
  .research-question-dropdown[open] > summary::after {
    content: '−';
  }
  .research-question-dropdown > summary:hover {
    color: var(--accent);
  }
  .research-question-dropdown .research-detail-body {
    padding: 12px 36px 0 0;
    max-width: 70ch;
  }
  .research-question-dropdown .research-detail-body p {
    font-size: 17px;
  }
  @media (max-width: 640px) {
    .research-question-list {
      gap: 24px;
    }
    .research-question-dropdown > summary,
    .research-question-static {
      font-size: 22px;
    }
  }
  @media print {
    .research-question-item {
      break-inside: avoid;
    }
    .research-question-dropdown .research-detail-body {
      padding-bottom: 10pt;
    }
  }
</style>
