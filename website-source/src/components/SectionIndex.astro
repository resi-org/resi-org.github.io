---
interface Props {
  items: [string, string][];
  home?: boolean;
}
const { items, home = false } = Astro.props;
const label = home ? 'Page sections' : 'On this page';
const markHeight = Math.max(18, items.length * 3);
---

<nav
  class:list={['section-index', { 'home-index': home, 'page-index': !home }]}
  aria-label={label}
  style={`--section-count: ${items.length}`}
>
  <details class="section-index-disclosure" open>
    <summary aria-label={label}>
      <svg
        class="section-index-mark"
        width="18"
        height="24"
        viewBox={`0 0 14 ${markHeight}`}
        aria-hidden="true"
      >
        {items.map(([href], i) => (
          <path data-section={href.slice(1)} d={`M1 ${1.5 + i * 3}h12`} />
        ))}
      </svg>
      <span class="section-index-label">{label}</span>
    </summary>
    <ul>
      {items.map(([href, label]) => (
        <li>
          <a href={href}>
            <span>{label}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>
</nav>

<script>
  const index = document.querySelector<HTMLElement>('.section-index');
  const header = document.querySelector<HTMLElement>('.site-header');
  const main = document.querySelector<HTMLElement>('main');

  if (index && header && main) {
    const entries = [...index.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
      .map((link) => ({ link, section: document.getElementById(link.hash.slice(1)) }))
      .filter(
        (entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => !!entry.section,
      );
    const disclosure = index.querySelector<HTMLDetailsElement>('details')!;
    const trigger = disclosure.querySelector<HTMLElement>('summary')!;
    const hoverAvailable = matchMedia('(hover: hover) and (pointer: fine)');
    const floating = matchMedia('(min-width: 1280px) and (min-height: 620px)');
    let pinned = false;
    let pointerSelecting = false;
    let suppressFocusReveal = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let scheduled = false;

    function close() {
      clearTimeout(closeTimer);
      pinned = false;
      disclosure.open = !floating.matches;
    }
    index.addEventListener('pointerenter', () => {
      clearTimeout(closeTimer);
      if (floating.matches && hoverAvailable.matches) disclosure.open = true;
    });
    index.addEventListener('pointerleave', () => {
      closeTimer = setTimeout(() => {
        if (!pinned && !index!.contains(document.activeElement)) close();
      }, 160);
    });
    index.addEventListener('focusin', () => {
      if (floating.matches && !suppressFocusReveal && hoverAvailable.matches)
        disclosure.open = true;
    });
    index.addEventListener('focusout', (event) => {
      // Safari may focus the main element on pointer-down before an anchor's click.
      // Keep the link in place until that click has had a chance to navigate.
      if (!pointerSelecting && !index!.contains(event.relatedTarget as Node | null)) close();
    });
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      pinned = !pinned;
      disclosure.open = pinned;
    });
    index.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      close();
      suppressFocusReveal = true;
      trigger.focus();
      suppressFocusReveal = false;
    });
    document.addEventListener(
      'pointerdown',
      (event) => {
        pointerSelecting = index!.contains(event.target as Node);
        if (!pointerSelecting) close();
      },
      true,
    );
    // Touch browsers dispatch compatibility focus events after pointer-up, before click.
    document.addEventListener('click', () => {
      pointerSelecting = false;
    });
    document.addEventListener('pointercancel', () => {
      pointerSelecting = false;
    });
    document.addEventListener(
      'keydown',
      () => {
        pointerSelecting = false;
      },
      true,
    );
    for (const { link, section } of entries) {
      link.addEventListener('click', () => {
        close();
        // Continue keyboard reading at the destination after following the native anchor.
        requestAnimationFrame(() => {
          const heading = section.querySelector<HTMLElement>('h2') || section;
          const previousTabIndex = heading.getAttribute('tabindex');
          heading.setAttribute('tabindex', '-1');
          heading.focus({ preventScroll: true });
          heading.addEventListener(
            'blur',
            () => {
              if (previousTabIndex === null) heading.removeAttribute('tabindex');
              else heading.setAttribute('tabindex', previousTabIndex);
            },
            { once: true },
          );
        });
      });
    }

    function update() {
      scheduled = false;
      const headerHeight = header!.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--home-header-height', `${headerHeight}px`);
      const readingLine = Math.min(innerHeight * 0.3, headerHeight + 100);
      let current: HTMLAnchorElement | undefined;
      for (const { link, section } of entries) {
        if (section.getBoundingClientRect().top <= readingLine) current = link;
      }
      if (scrollY > 0 && scrollY + innerHeight >= document.documentElement.scrollHeight - 2) {
        current = entries.at(-1)?.link;
      }
      for (const { link } of entries) {
        if (link === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
        index!
          .querySelector(`[data-section="${link.hash.slice(1)}"]`)
          ?.classList.toggle('is-current', link === current);
      }
    }

    function queueUpdate() {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(update);
      }
    }

    floating.addEventListener('change', () => {
      close();
      queueUpdate();
    });
    close();
    addEventListener('scroll', queueUpdate, { passive: true });
    addEventListener('resize', queueUpdate);
    addEventListener('hashchange', queueUpdate);
    addEventListener('pageshow', queueUpdate);
    // Recalculate after fonts, disclosure expansion, or header resizing changes section positions.
    const observer = new ResizeObserver(queueUpdate);
    observer.observe(header);
    observer.observe(main);
    document.fonts.ready.then(queueUpdate);
    update();
  }
</script>
