---
import DisclosureControl from './DisclosureControl.astro';
// Render one authored body into native disclosure and print-only fallback.
// WebKit cannot expose a closed native disclosure using print CSS alone.
interface Props {
  id?: string;
  summary: string;
  summaryLead?: string;
  compactControl?: boolean;
  explanatory?: boolean;
  inlineControl?: boolean;
  accessibleLabel?: string;
  class?: string;
}
const { id, summary, summaryLead, compactControl = false, explanatory = compactControl, inlineControl = false, accessibleLabel, class: className } = Astro.props;
const lastSpace = summary.lastIndexOf(' ');
const summaryStart = summary.slice(0, lastSpace + 1);
const summaryEnd = summary.slice(lastSpace + 1);
const body = await Astro.slots.render('default');
---

<details id={id} class:list={[className, { 'compact-disclosure': compactControl, 'explanatory-disclosure': explanatory, 'inline-disclosure': inlineControl }]} data-print-copy>
  <summary aria-label={accessibleLabel}>
    {summaryLead ? (
      <span class="research-summary">
        <span class="research-question-title">{summary}</span>
        <span class="research-question-lead">{summaryLead}</span>
      </span>
    ) : inlineControl ? (
      <span class="disclosure-summary-text">{summaryStart}<span class="disclosure-summary-end">{summaryEnd}<DisclosureControl showHint={false} /></span></span>
    ) : !compactControl ? (explanatory ? <span>{summary}</span> : summary) : null}
    {explanatory && !inlineControl && <DisclosureControl />}
  </summary>
  <Fragment set:html={body} />
</details>
<div class:list={['print-disclosure', className]} aria-hidden="true">
  <h3>{summary}</h3>
  {summaryLead && <p>{summaryLead}</p>}
  <Fragment set:html={body} />
</div>
