---
import { getCollection } from 'astro:content';
import { portraitFor } from '../lib/portraits';
import Base from '../layouts/Base.astro';
import ResearchAreaCards from '../components/ResearchAreaCards.astro';
import ResearchTeamMosaic from '../components/ResearchTeamMosaic.astro';
import Arrow from '../components/Arrow.astro';
import { type EventEntry, getAnnouncements, fmtDay } from '../lib/announcements';
import { selectHomepageAnnouncements } from '../lib/event-announcement-policy';
import { external } from '../lib/external';
import SectionLinks from './SectionLinks.astro';
import WorkshopCallout from './WorkshopCallout.astro';
import { institute, researchAgenda } from '../data/institute';
import { organization } from '../data/seo';
const entries = selectHomepageAnnouncements(await getAnnouncements());
const featuredWorkshop = entries.find((entry): entry is EventEntry => entry.category === 'Events' && entry.anchor === 'workshop');
const people = await getCollection('people');
// Every non-founder People profile with a photo joins automatically on rebuild.
// Preserve the current research-first order; Operations follows in the rotation.
const teamWithPhotos = people
  .filter((p) => p.data.group !== 'founders' && p.data.photo)
  .sort((a, b) =>
    Number(a.data.group !== 'research') - Number(b.data.group !== 'research')
    || a.data.order - b.data.order,
  );
const founders = people
  .filter((p) => p.data.group === 'founders')
  .sort((a, b) => a.data.order - b.data.order);
---

<Base wide description={organization.description}>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-grid">
      <h1 id="hero-title">
        The Institute for
        <br />
        Responsible Superintelligence
      </h1>
      {featuredWorkshop && (
        <section class="home-featured-workshop" aria-labelledby="save-date-heading">
          <WorkshopCallout headingId="featured-workshop-heading" event={featuredWorkshop} integrated featured>
            <h2 slot="heading" id="save-date-heading">Save the date</h2>
          </WorkshopCallout>
        </section>
      )}
      <div class="hero-copy">
        <p class="hero-description">
          RESI is an independent nonprofit AI safety research institute based in Cambridge, Massachusetts, where
          we are building the scientific foundations for making superintelligence <strong>safe by design</strong>.
        </p>
        <div class="hero-mission" id="mission">
          <p class="safe-definition">
            <strong>Safe by design</strong> means safety properties are specified in advance and
            achieved by mechanisms whose guarantees can be analyzed before deployment.
          </p>
          <p class="mission-bridge">
            As AI systems become more capable, we need to understand what will keep them trustworthy
            and under human control. RESI brings technical, legal, and economic research together
            around that question, drawing on the scientific approach that transformed modern
            cryptography.
          </p>
        </div>
      </div>
      <div class="actions hero-actions">
        <a class="button" href="/research">
          Explore our research program <Arrow />
        </a>
        <a class="button secondary" href="/support">
          Support our work <Arrow />
        </a>
        <a class="button secondary" href="/events">
          See all events and seminars <Arrow />
        </a>
      </div>
    </div>
  </section>
  <section class="home-band tint" id="argument" aria-labelledby="precedent-heading">
    <div class="shell home-rationale">
      <h2 id="precedent-heading">The modern cryptography precedent</h2>
      <p>
        Long ago, encryption schemes were ad hoc: constantly broken, red-teamed, and patched. Modern
        cryptography began when researchers formulated definitions of computational security and
        invented primitives that could provably satisfy them under explicit mathematical
        assumptions: public-key encryption, digital signatures, zero-knowledge proofs, multi-party
        computation, and obfuscation. These inventions have withstood decades of attacks and
        enormous increases in computing power.
      </p>
      <p>
        <strong>RESI is a bet that such guarantees are possible for superintelligence safety</strong>, and that it
        will happen by bringing together researchers who aim their efforts at responsible
        superintelligence, using frontier AI tools.
      </p>
    </div>
  </section>
  <section class="home-band tint" id="founders" aria-labelledby="people-heading">
    <span id="institution" aria-hidden="true"></span>
    <span id="institution-heading" aria-hidden="true"></span>
    <div class="shell">
      <div class="section-heading">
        <div>
          <h2 id="people-heading">Founders</h2>
        </div>
      </div>
      <ul class="home-founders">
        {founders.map((p) => (
          <li class="home-founder">
            <span class="founder-portrait" style={portraitFor(p.id, p.data.photo).style}>
              <img src={portraitFor(p.id, p.data.photo).src} alt="" width="90" height="90" loading="lazy" />
            </span>
            <h3>
              <a href={`/people#${p.id}`}>
                <span class="founder-name-line">{p.data.name.split(' ')[0]}</span><br />
                <span class="founder-name-line">{p.data.name.split(' ').slice(1).join(' ')}</span>
              </a>
            </h3>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
      <div class="community">
        <ResearchTeamMosaic people={teamWithPhotos} />
        <div class="community-invite">
          <h3 class="community-heading">Research community</h3>
          <SectionLinks items={[
            { label: 'Meet the team', href: '/people#research' },
            { label: 'Explore foundational work', href: '/research#evidence' },
          ]} />
        </div>
      </div>
    </div>
  </section>
  <section class="home-band" id="announcements" aria-labelledby="announcements-heading">
    <div class="shell home-announcements">
      <h2 id="announcements-heading">Announcements</h2>
      <ul class="announcement-list">
        {entries.map((entry) => {
          if (entry.category === 'Events') {
            return <li class="event-announcement"><WorkshopCallout event={entry} integrated /></li>;
          }
          const href = entry.kind === 'Press' && entry.url ? entry.url : `/news#${entry.id}`;
          return (
            <li class="announcement-item">
              <p class="announcement-meta">
                <span>News</span>
                {entry.source && <span>{entry.source}</span>}
                <time datetime={entry.date.toISOString().slice(0, 10)}>{fmtDay(entry.date)}</time>
              </p>
              <h3>
                <a href={href} {...external(href)}>
                  {entry.homepageTitle || entry.title}
                </a>
              </h3>
              {(entry.homepageSummary || entry.summary) && (
                <p class="announcement-summary">{entry.homepageSummary || entry.summary}</p>
              )}
            </li>
          );
        })}
      </ul>
      <SectionLinks align="end" items={[
        { label: 'See all news', href: '/news' },
        { label: 'See community events', href: '/events' },
      ]} />
    </div>
  </section>
  <section class="home-band tint" id="research" aria-labelledby="research-heading">
    <div class="shell">
      <div class="section-heading">
        <div>
          <h2 id="research-heading">Key research areas</h2>
        </div>
        {researchAgenda.intro && <p>{researchAgenda.intro}</p>}
      </div>
      <ResearchAreaCards />
      <SectionLinks align="end" items={[
        { label: 'See all our research areas', href: '/research#areas' },
        { label: 'See our full research program', href: '/research' },
      ]} />
    </div>
  </section>
  <section class="home-band" id="support" aria-labelledby="support-heading">
    <div class="shell">
      <span id="progress-heading" aria-hidden="true"></span>
      <div class="support-invite">
        <div class="support-heading-row">
          <h2 id="support-heading">Support independent research on safe superintelligence</h2>
          <a class="support-learn-more" href="/support">
            Learn more <Arrow />
          </a>
        </div>
        <div>
          <p>
            Donations will enable us to bring in more researchers, especially postdocs and junior
            researchers, and further accelerate our research using AI. We also welcome support
            through compute credits and infrastructure.
          </p>
        </div>
      </div>
      <p class="support-acknowledgment" id="fiscal-sponsor">
        RESI is supported by grants from {institute.supporters.join(', ').replace(/, ([^,]*)$/, ', and $1')}.
        Fiscally sponsored by {institute.sponsor.name}.
      </p>
    </div>
  </section>
  <script>
    const priorWorkHashes = new Set([
      '#evidence',
      '#filtering-limits-paper',
      '#covert-conversations-paper',
      '#data-attribution-paper',
    ]);
    function followPriorWorkLink() {
      if (priorWorkHashes.has(location.hash)) location.replace('/research#evidence');
    }
    followPriorWorkLink();
    addEventListener('hashchange', followPriorWorkLink);
  </script>
</Base>

<style>
  .hero.shell {
    width: min(var(--content-width), calc(100% - 48px));
    padding-top: 44px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas: "title title" "copy event" "actions actions";
    align-items: start;
    gap: 0 20px;
  }
  .hero-grid > * {
    min-width: 0;
  }
  #hero-title {
    grid-area: title;
    font-size: clamp(31px, 6vw, 40px);
  }
  .hero-copy { grid-area: copy; }
  .hero-actions {
    grid-area: actions;
    flex-wrap: wrap;
  }
  @media (min-width: 521px) {
    /* Distribute the few remaining pixels through existing paragraph gaps. */
    .hero-copy {
      align-self: stretch;
      display: grid;
      grid-template-rows: auto 1fr;
      row-gap: 24px;
    }
    .hero-copy .hero-mission {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      margin-top: 0;
    }
    .hero-copy .safe-definition { margin-top: 0; }
    .hero-copy .mission-bridge { margin-top: 17px; }
    .home-featured-workshop {
      align-self: stretch;
      display: flex;
    }
  }
  .home-featured-workshop {
    grid-area: event;
    container-type: inline-size;
  }
  .home-featured-workshop #save-date-heading {
    font: 700 26.25px/1.18 var(--serif);
    letter-spacing: -.01em;
    grid-column: 1 / -1;
    grid-row: 1;
    margin: 0;
    color: var(--accent);
  }
  @media (max-width: 600px) {
    #hero-title { font-size: clamp(34.1px, 6.6vw, 44px); }
  }
  @media (max-width: 520px) {
    #hero-title { font-size: clamp(29.7px, 6.875vw, 36.3px); }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "title" "event" "copy" "actions";
    }
    .home-featured-workshop {
      margin-bottom: 27px;
    }
  }
  .home-announcements .announcement-list {
    margin-top: 0;
  }
  .event-announcement {
    margin: 0;
    min-width: 0;
  }
  .home-announcements .announcement-meta > span:first-child::before {
    content: none;
  }
  .home-announcements .announcement-meta > time::before {
    content: '·';
    margin-right: 7.5px;
  }
  #founders .community-heading {
    margin-bottom: 0;
  }
  @media (min-width: 525.75px) {
    /* This compact panel aligns its links with the two portrait rows. */
    .community-invite :global(.section-links) {
      margin-top: 6px;
      gap: 6px;
    }
    .community :global(.team-mosaic) {
      align-self: stretch;
    }
    .community :global(.research-team-mosaic.is-rotating) {
      height: 100%;
      align-content: space-between;
    }
  }
  .support-heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .support-heading-row #support-heading {
    margin: 0;
  }
  .support-learn-more {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 40px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
    background: var(--accent);
    color: var(--paper);
    padding: 10px 14px;
    border: 1px solid var(--accent);
    border-radius: 1.5px;
  }
  .support-learn-more :global(svg) {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }
  .support-learn-more:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }
  .support-learn-more:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  @media (max-width: 525px) {
    .support-heading-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
  #support-heading {
    font-size: 26.25px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .support-acknowledgment {
    margin-top: 18px;
    text-wrap: pretty;
  }
  @media (max-width: 480px) {
    .hero.shell {
      width: calc(100% - 27px);
      padding-top: 32px;
    }
    #support-heading {
      font-size: 23.25px;
    }
  }
</style>

<script is:inline>
  const legacyAnchors = { '#founding-team': '/people/#founders', '#research-team': '/people/#research' };
  function restoreLegacyAnchor() {
    if (legacyAnchors[location.hash]) location.replace(legacyAnchors[location.hash]);
  }
  restoreLegacyAnchor();
  addEventListener('hashchange', restoreLegacyAnchor);
</script>
