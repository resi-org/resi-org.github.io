---
interface Props {
  id: string;
  items: { label: string; href: string }[];
}
const { id, items } = Astro.props;
---

<div class="page-shortcuts-bar">
<nav class="page-shortcuts" aria-label="On this page">
  <button type="button" aria-expanded="true" aria-controls={id}>
    On this page <span class="shortcut-mark" aria-hidden="true">−</span>
  </button>
  <ul id={id} role="list">
    {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
  </ul>
</nav>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.page-shortcuts').forEach((nav) => {
    const bar = nav.closest<HTMLElement>('.page-shortcuts-bar')!;
    const header = document.querySelector<HTMLElement>('.site-header')!;
    const root = document.documentElement;
    const compact = matchMedia('(max-width: 480px), (pointer: coarse)');
    const enoughHeight = matchMedia('(min-height: 480px)');
    const measure = () => {
      root.style.setProperty('--contents-header-height', `${header.getBoundingClientRect().height}px`);
      root.style.setProperty('--contents-height', `${enoughHeight.matches ? bar.getBoundingClientRect().height : 0}px`);
    };
    const toggle = nav.querySelector('button')!;
    const links = nav.querySelector('ul')!;
    const mark = nav.querySelector('.shortcut-mark')!;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      links.hidden = !open;
      mark.textContent = open ? '−' : '+';
      measure();
    };
    setOpen(false);
    nav.dataset.ready = '';
    root.dataset.pageShortcuts = '';
    const observer = new ResizeObserver(measure);
    observer.observe(header);
    observer.observe(bar);
    enoughHeight.addEventListener('change', measure);
    document.fonts.ready.then(measure);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !links.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    links.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a') : null;
      if (!link || !compact.matches) return;
      setOpen(false);
      // Move keyboard focus out of the collapsed menu to the chosen section.
      const target = document.getElementById(link.hash.slice(1));
      if (target) requestAnimationFrame(() => {
        const previous = target.getAttribute('tabindex');
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
        target.addEventListener('blur', () => {
          if (previous === null) target.removeAttribute('tabindex');
          else target.setAttribute('tabindex', previous);
        }, { once: true });
      });
    });
    const mainMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    mainMenu?.addEventListener('toggle', () => { if (mainMenu.open) setOpen(false); });
  });
</script>

<style>
  .page-shortcuts-bar {
    position: sticky;
    /* A slight overlap prevents subpixel seams beneath the sticky header. */
    top: calc(var(--contents-header-height, 68.25px) - 1px);
    z-index: 95;
    padding: 0 0 var(--shortcut-divider-gap);
    background: var(--paper);
  }
  .page-shortcuts-bar::before {
    content: '';
    position: absolute;
    inset: -1px 0 0;
    z-index: -1;
    background: var(--paper);
    /* Cover wider sections too, without adding horizontal scroll width. */
    box-shadow: 0 0 0 100vw var(--paper);
    clip-path: inset(0 -100vw);
    pointer-events: none;
  }
  :global(html[data-page-shortcuts]) {
    scroll-padding-top: calc(var(--contents-header-height) + var(--contents-height) + 10px);
  }
  :global(html[data-page-shortcuts] main [id]) {
    scroll-margin-top: 0;
  }
  .page-shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7.5px 16.5px;
    max-width: var(--content-width);
    margin: 0 auto;
    /* Align every contents menu with the intro button outer edge. */
    padding-inline: 0;
    border-inline: 0;
    color: var(--accent);
    font: 500 9px/1.5 var(--sans);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .page-shortcuts button,
  .page-shortcuts a {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
  }
  .page-shortcuts button {
    display: inline-flex;
    align-items: baseline;
    gap: 5.25px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    cursor: pointer;
  }
  .page-shortcuts ul { display: contents; list-style: none; }
  .page-shortcuts ul[hidden] { display: none; }
  .page-shortcuts li { margin: 0; padding: 0; }
  .page-shortcuts a { text-decoration: none; }
  .page-shortcuts a:hover,
  .page-shortcuts button:hover { text-decoration: underline; text-underline-offset: 3px; }
  .page-shortcuts:not([data-ready]) button { display: none; }
  @media (max-width: 480px), (pointer: coarse) {
    .page-shortcuts-bar { padding-top: 0; }
    .page-shortcuts button, .page-shortcuts a { min-height: 44px; }
    .page-shortcuts button { align-items: center; }
    .page-shortcuts a { display: flex; align-items: center; }
    .page-shortcuts ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 15px; width: 100%; padding: 0; margin: 0; }
    .page-shortcuts ul[hidden] { display: none; }
    .page-shortcuts { row-gap: 0; }
  }
  @media (max-height: 479px) { .page-shortcuts-bar { position: static; } }
  @media print { .page-shortcuts-bar { display: none; } }
</style>
