---
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Arrow from '../components/Arrow.astro';
import WorkshopPortrait from '../components/WorkshopPortrait.astro';
import WorkshopBioLink from '../components/WorkshopBioLink.astro';
import WorkshopNameLines from '../components/WorkshopNameLines.astro';
import { workshopPortraits, workshopHostPhotoCredits } from '../data/workshop-portraits';
import { portraitFor } from '../lib/portraits';
import { workshopParticipantPortraits } from '../data/workshop-participant-portraits';
import type { WorkshopPhoto } from '../data/workshop-portraits';
import { workshopProgram, workshopTalkAnchor, workshopTimeRange } from '../data/workshop-program';

interface Props { layout: 'roster' | 'integrated'; }
const { layout } = Astro.props;
// Review options share canonical facts and selected portraits with the published workshop.
const entry = await getEntry('events', '2026-12-04-inaugural-workshop');
if (!entry) throw new Error('The inaugural workshop record is missing.');
const event = entry.data;
const titleExtension = "RESI's inaugural workshop on developing scientific foundations for safer advanced AI";
const pageTitle = `${event.title}: ${titleExtension}`;
const subtitle = "RESI's inaugural workshop on developing scientific foundations for safer advanced AI, bringing together researchers from frontier labs, safety organizations, and academia.";
const speakerPhotographyCredits = event.speakers.flatMap((speaker) => {
  const credit = workshopPortraits[speaker.name].credit;
  return credit ? [{ person: speaker.name, credit }] : [];
});
const hostIds = ['shafi-goldwasser', 'adam-tauman-kalai', 'vinod-vaikuntanathan'];
const hosts = await Promise.all(hostIds.map(async (id) => {
  const person = await getEntry('people', id);
  if (!person) throw new Error(`Missing workshop host: ${id}`);
  return { name: person.data.name, portrait: portraitFor(id, person.data.photo) };
}));
const people = await getCollection('people');
const teamBios: Record<string, string> = Object.fromEntries(people.map((person) => [person.data.name, `/people#${person.id}`]));
const teamPortraits: Record<string, WorkshopPhoto> = Object.fromEntries(people.filter((person) => person.data.photo).map((person) => {
  const portrait = portraitFor(person.id, person.data.photo);
  return [person.data.name, { src: portrait.src!, style: portrait.style, label: 'Existing RESI People portrait' }];
}));
const participantPortraits = { ...teamPortraits, ...workshopPortraits, ...workshopParticipantPortraits };
const programNames = [...event.panels.flatMap((title) => event.panelDetails[title]?.participants.map((person) => person.name) ?? []), ...(event.spotlights?.speakers ?? [])];
for (const name of programNames) {
  if (!participantPortraits[name]) throw new Error(`Missing selected workshop portrait: ${name}`);
}
const programPhotographyCredits = programNames.flatMap((name) => {
  const credit = participantPortraits[name]?.credit;
  return credit ? [{ person: name, credit }] : [];
});
const photographyCredits = [...speakerPhotographyCredits, ...programPhotographyCredits, ...hosts.flatMap((host) => {
  const credit = workshopHostPhotoCredits[host.portrait.src ?? ''];
  return credit ? [{ person: host.name, credit }] : [];
})].filter((entry, index, credits) => credits.findIndex((item) => item.credit.id === entry.credit.id) === index);
const date = event.start.toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
const programEntries = workshopProgram.map((session) => {
  let title = '';
  let href: string | undefined;
  let speaker: string | undefined;
  let affiliation: string | undefined;
  let moderator: string | undefined;
  let participants: string[] = [];
  if (session.kind === 'talk' || session.kind === 'keynote') {
    const person = event.speakers.find((person) => person.name === session.speaker);
    if (!person) throw new Error(`Program speaker is missing from the workshop roster: ${session.speaker}`);
    title = person.talkTitle || 'Title to be announced';
    speaker = person.name;
    affiliation = person.affiliation;
    href = `#${workshopTalkAnchor(person.name)}`;
  } else if (session.kind === 'panel') {
    title = event.panels[session.panel];
    const panel = event.panelDetails[title];
    if (!panel) throw new Error(`Program panel is missing: ${session.panel}`);
    moderator = panel.moderator;
    participants = panel.participants.map((person) => person.name);
    href = `#panel-${session.panel + 1}`;
  } else if (session.kind === 'spotlights') {
    title = 'RESI research spotlights';
    moderator = event.spotlights?.moderator;
    href = '#spotlights';
  } else if ('title' in session) {
    title = session.title;
    if ('speaker' in session) speaker = session.speaker;
  } else {
    throw new Error('Program session has no public title.');
  }
  return { ...session, id: href ? `schedule-${href.slice(1)}` : `schedule-${session.start.replace(':', '')}`, title, href, speaker, affiliation, moderator, participants };
});
---

<Base
  title={`${pageTitle} — ${layout === "roster" ? "Portrait roster preview" : "Integrated program preview"}`}
  description={event.overview || event.description}
  wide
  noindex
>
  <article class:list={["workshop-page", `preview-${layout}`]}>
    <header class="page-hero workshop-hero">
      <div class="workshop-heading">
        <h1><span class="title-phrase">{event.title.split(' ')[0]}</span>{' '}{event.title.split(' ').slice(1).join(' ')}</h1>
        <p class="workshop-subtitle">{subtitle}</p>
        <div class="workshop-facts" aria-label="Date, time, location and attendance">
          <span><time datetime={event.start.toISOString().slice(0, 10)}>{date}</time></span>
          <span class="workshop-location">{event.location}{event.attendanceLabel && <> · {event.attendanceLabel}</>}</span>
          <span class="workshop-hours">9am–5pm · Check-in and breakfast from 8:30am</span>
        </div>
      </div>
      {event.interestUrl && <div class="workshop-invitation">
        <p class="workshop-join-label">Join us:</p>
        <a class="workshop-interest" href={event.interestUrl} target="_blank" rel="noopener noreferrer">
          {event.interestLabel || 'Interest form'}<Arrow />
        </a>
      </div>}
      {event.interestNote && <p class="interest-note">{event.interestNote}</p>}
      <nav class="workshop-sections" aria-label="Workshop sections">
        {layout === 'roster' && <>
          <a href="#speakers">Speakers</a>
          <a href="#program">Panelists</a>
          <a href="#spotlights">RESI research spotlights</a>
        </>}
        <a href="#schedule">Program</a>
        <a href="#directions">Getting here</a>
      </nav>
    </header>

    {layout === 'roster' && <>
    <Section id="speakers" label="Speakers" divider>
      <ul class="speaker-list">
        {event.speakers.map((speaker) => <li id={workshopTalkAnchor(speaker.name)}>
          <div class="speaker-photo"><WorkshopBioLink name={speaker.name} href={teamBios[speaker.name]} portrait><WorkshopPortrait name={speaker.name} photo={workshopPortraits[speaker.name]} /></WorkshopBioLink></div>
          <div class="speaker-copy">
            <h3 class="speaker-name"><WorkshopBioLink name={speaker.name} href={teamBios[speaker.name]}>{speaker.name}</WorkshopBioLink></h3>
            {speaker.affiliation && <p class="speaker-affiliation">{speaker.affiliation}</p>}

          </div>
        </li>)}
      </ul>
    </Section>

    <Section id="program" label="Panelists" divider>
      {event.panels.length > 0 && <ul class="program-panels">
        {event.panels.map((title, index) => <li id={`panel-${index + 1}`}>
          <h3><a href={`#schedule-panel-${index + 1}`}>{title}</a></h3>
          {event.panelDescriptions[title] && <p class="panel-description">{event.panelDescriptions[title]}</p>}
          {event.panelDetails[title] ? <>
            <ul class="participant-list" style={`--participant-count: ${event.panelDetails[title].participants.length};`}>
              {event.panelDetails[title].participants.map((person) => <li>
                <div class="participant-photo"><WorkshopBioLink name={person.name} href={teamBios[person.name]} portrait><WorkshopPortrait name={person.name} photo={participantPortraits[person.name]} square /></WorkshopBioLink></div>
                <p class="participant-name"><WorkshopBioLink name={person.name} href={teamBios[person.name]}><WorkshopNameLines name={person.name} /></WorkshopBioLink></p>
                {person.affiliation && <p class="participant-affiliation">{person.name === 'Jacob Tsimerman'
                  ? <><span class="affiliation-line">{person.affiliation.split(' of ')[0]}</span>{' '}<span class="affiliation-line">of {person.affiliation.split(' of ').slice(1).join(' of ')}</span></>
                  : person.affiliation}</p>}
              </li>)}
            </ul>
            {event.panelDetails[title].moderator && <p class="program-moderator">Moderated by <WorkshopBioLink name={event.panelDetails[title].moderator} href={teamBios[event.panelDetails[title].moderator]}>{event.panelDetails[title].moderator}</WorkshopBioLink>.</p>}
          </> : <p class="program-moderator">Panelists will be announced soon.</p>}
        </li>)}
      </ul>}
    </Section>

    {event.spotlights && <Section id="spotlights" label="RESI research spotlights" labelHref="#schedule-spotlights" divider>
      <ul class="participant-list spotlight-list" style={`--participant-count: ${event.spotlights.speakers.length};`}>
        {event.spotlights.speakers.map((name) => <li>
          <div class="participant-photo"><WorkshopBioLink name={name} href={teamBios[name]} portrait><WorkshopPortrait name={name} photo={participantPortraits[name]} square /></WorkshopBioLink></div>
          <p class="participant-name"><WorkshopBioLink name={name} href={teamBios[name]}><WorkshopNameLines name={name} /></WorkshopBioLink></p>
        </li>)}
      </ul>
      {event.spotlights.moderator && <p class="program-moderator">Moderated by <WorkshopBioLink name={event.spotlights.moderator} href={teamBios[event.spotlights.moderator]}>{event.spotlights.moderator}</WorkshopBioLink>.</p>}
    </Section>}

    </>}

    <Section id="schedule" label="Program" divider>
      <p class="schedule-note"><em>Session times are subject to change.</em></p>
      {layout === 'roster' ? <>
      <ol class="timetable">
        {programEntries.map((session) => <li id={session.id} tabindex="-1" class:list={['schedule-row', { 'schedule-pause': ['arrival', 'break', 'meal'].includes(session.kind) }]}>
          <div class="session-time" aria-label={workshopTimeRange(session.start, session.end)}>
            <time datetime={`2026-12-04T${session.start}:00-05:00`}>{workshopTimeRange(session.start, session.end).split('–')[0]}</time>–<time datetime={`2026-12-04T${session.end}:00-05:00`}>{workshopTimeRange(session.start, session.end).split('–')[1]}</time>
          </div>
          <div class="session-copy">
            {(session.kind === 'panel' || session.kind === 'keynote') && <p class="session-kind">{session.kind === 'panel' ? 'Panel' : 'Keynote'}</p>}
            <h3 class="session-title">{session.href && (session.kind === 'panel' || session.kind === 'spotlights') ? <a href={session.href}>{session.title}</a> : session.title}</h3>
            {session.speaker && <p class="session-byline"><WorkshopBioLink name={session.speaker} href={teamBios[session.speaker]}>{session.speaker}</WorkshopBioLink>{session.affiliation && <span class="session-affiliation"> · {session.affiliation}</span>}</p>}
            {session.participants.length > 0 && <p class="session-participants">{session.participants.join(', ')}</p>}
            {session.moderator && <p class="session-moderator">Moderated by <WorkshopBioLink name={session.moderator} href={teamBios[session.moderator]}>{session.moderator}</WorkshopBioLink>.</p>}
            {session.kind === 'spotlights' && event.spotlights && <ul class="spotlight-program">
              {event.spotlights.speakers.map((name) => <li>
                <WorkshopBioLink name={name} href={teamBios[name]}>{name}</WorkshopBioLink>: {event.spotlights!.titles[name]?.title || 'Title to be announced'}{event.spotlights!.titles[name]?.working && <span class="working-title"> (working title)</span>}
              </li>)}
            </ul>}
          </div>
        </li>)}
      </ol>
      </> : <>
      <ol class="timetable integrated-timetable">
        {programEntries.map((session) => {
          const isTalk = session.kind === 'talk' || session.kind === 'keynote';
          const panel = session.kind === 'panel' ? event.panelDetails[session.title] : undefined;
          const host = !isTalk && session.speaker ? hosts.find((host) => host.name === session.speaker) : undefined;
          return <li id={session.id} tabindex="-1" class:list={['schedule-row', { 'schedule-pause': ['arrival', 'break', 'meal'].includes(session.kind), 'session-with-portrait': isTalk, 'session-group': !!panel || session.kind === 'spotlights', 'session-host': !!host }]}>
            <div class="session-time" aria-label={workshopTimeRange(session.start, session.end)}>
              <span class="time-start"><time datetime={`2026-12-04T${session.start}:00-05:00`}>{workshopTimeRange(session.start, session.end).split('–')[0]}</time>–</span><time class="time-end" datetime={`2026-12-04T${session.end}:00-05:00`}>{workshopTimeRange(session.start, session.end).split('–')[1]}</time>
              {(session.kind === 'panel' || session.kind === 'keynote') && <span class="session-type">{session.kind === 'panel' ? 'Panel' : 'Keynote'}</span>}
            </div>
            {isTalk && session.speaker ? <div class="integrated-talk" id={workshopTalkAnchor(session.speaker)}>
              <div class="integrated-speaker-photo"><WorkshopBioLink name={session.speaker} href={teamBios[session.speaker]} portrait><WorkshopPortrait name={session.speaker} photo={workshopPortraits[session.speaker]} /></WorkshopBioLink></div>
              <div class="session-copy">
                <h3 class:list={['integrated-talk-title', { 'talk-pending': !event.speakers.find((person) => person.name === session.speaker)?.talkTitle }]}>{session.title}</h3>
                <div class="integrated-speaker-details">
                  <p class="integrated-speaker-name"><WorkshopBioLink name={session.speaker} href={teamBios[session.speaker]}>{session.speaker}</WorkshopBioLink></p>
                  {session.affiliation && <p class="integrated-affiliation">{session.affiliation}</p>}
                </div>
              </div>
            </div> : <div class="session-copy">
              <h3 class="session-title" id={panel ? session.href?.slice(1) : session.kind === 'spotlights' ? 'spotlights' : undefined}>{session.title}</h3>
              {panel && <>
                <ul class="participant-list" style={`--participant-count: ${panel.participants.length};`}>
                  {panel.participants.map((person) => <li>
                    <div class="participant-photo"><WorkshopBioLink name={person.name} href={teamBios[person.name]} portrait><WorkshopPortrait name={person.name} photo={participantPortraits[person.name]} square /></WorkshopBioLink></div>
                    <p class="participant-name"><WorkshopBioLink name={person.name} href={teamBios[person.name]}><WorkshopNameLines name={person.name} /></WorkshopBioLink></p>
                    {person.affiliation && <p class="participant-affiliation">{person.name === 'Jacob Tsimerman'
                      ? <><span class="affiliation-line">{person.affiliation.split(' of ')[0]}</span>{' '}<span class="affiliation-line">of {person.affiliation.split(' of ').slice(1).join(' of ')}</span></>
                      : person.affiliation}</p>}
                  </li>)}
                </ul>
                {session.moderator && <p class="session-moderator">Moderated by <WorkshopBioLink name={session.moderator} href={teamBios[session.moderator]}>{session.moderator}</WorkshopBioLink>.</p>}
              </>}
              {session.kind === 'spotlights' && event.spotlights && <>
                <ul class="participant-list integrated-spotlights" style={`--participant-count: ${event.spotlights.speakers.length};`}>
                  {event.spotlights.speakers.map((name) => <li>
                    <div class="participant-photo"><WorkshopBioLink name={name} href={teamBios[name]} portrait><WorkshopPortrait name={name} photo={participantPortraits[name]} square /></WorkshopBioLink></div>
                    <p class="participant-name"><WorkshopBioLink name={name} href={teamBios[name]}><WorkshopNameLines name={name} /></WorkshopBioLink></p>
                    <p class="participant-affiliation">{event.spotlights!.titles[name]?.title || 'Title to be announced'}{event.spotlights!.titles[name]?.working && <span class="working-title"> (working title)</span>}</p>
                  </li>)}
                </ul>
                {session.moderator && <p class="session-moderator">Moderated by <WorkshopBioLink name={session.moderator} href={teamBios[session.moderator]}>{session.moderator}</WorkshopBioLink>.</p>}
              </>}
              {host && <div class="scheduled-host">
                <WorkshopBioLink name={host.name} href={teamBios[host.name]} portrait><span class="host-portrait founder-portrait" style={host.portrait.style}><img src={host.portrait.src} alt={`Portrait of ${host.name}`} width="64" height="64" loading="lazy" decoding="async" /></span></WorkshopBioLink>
                <p class="session-byline"><WorkshopBioLink name={host.name} href={teamBios[host.name]}>{host.name}</WorkshopBioLink><span class="scheduled-host-role">RESI co-founder</span></p>
              </div>}
              {!panel && session.kind !== 'spotlights' && !host && session.speaker && <p class="session-byline">{session.speaker}</p>}
            </div>}
          </li>;
        })}
      </ol>
      </>}
    </Section>

    {layout === 'roster' && <>
    <Section id="hosts" label={event.hostsLabel || 'Hosted by'} divider>
      <ul class="host-list">
        {hosts.map((host) => <li>
          <WorkshopBioLink name={host.name} href={teamBios[host.name]} portrait><span class="host-portrait founder-portrait" style={host.portrait.style}>
            <img src={host.portrait.src} alt="" width="80" height="80" loading="lazy" decoding="async" />
          </span></WorkshopBioLink>
          <span class="host-name"><WorkshopBioLink name={host.name} href={teamBios[host.name]}><WorkshopNameLines name={host.name} /></WorkshopBioLink></span>
        </li>)}
      </ul>
    </Section>

    </>}

    <Section id="directions" label="Getting here" divider>
      <div class="arrival-copy">
        <p>Akamai building, 145 Broadway, Cambridge, MA. <a href="https://www.google.com/maps/search/?api=1&query=145+Broadway%2C+Cambridge%2C+MA+02142" target="_blank" rel="noopener noreferrer">Google Maps</a></p>
        <p>Public transport is recommended: take the Red Line to Kendall/MIT, approximately a <a href="https://www.google.com/maps/dir/?api=1&origin=Kendall%2FMIT+station%2C+Cambridge%2C+MA&destination=145+Broadway%2C+Cambridge%2C+MA+02142&travelmode=walking" target="_blank" rel="noopener noreferrer">6-minute walk</a> away. Nearby paid public parking options include the <a href="https://www.google.com/maps/search/?api=1&query=Kendall+Center+Green+Garage%2C+90+Broadway%2C+Cambridge%2C+MA" target="_blank" rel="noopener noreferrer">Green Garage</a> on Broadway and the <a href="https://www.google.com/maps/search/?api=1&query=Kendall+Center+Yellow+Garage%2C+Cambridge%2C+MA" target="_blank" rel="noopener noreferrer">Yellow Garage</a> with an entrance on Ames Place.</p>
      </div>
    </Section>

    <div class="workshop-closing-invitation" id="join-us">
      {event.interestUrl && <div class="workshop-invitation">
        <p class="workshop-join-label">Join us:</p>
        <a class="workshop-interest" href={event.interestUrl} target="_blank" rel="noopener noreferrer">
          {event.interestLabel || 'Interest form'}<Arrow />
        </a>
      </div>}
      {event.interestNote && <p class="interest-note">{event.interestNote}</p>}
      <p class="conduct-link"><a href="/code-of-conduct/">Code of conduct</a></p>
    </div>

  </article>
  {photographyCredits.length > 0 && <section slot="before-footer" class="photography-credits shell" aria-labelledby="photography-credits-heading">
    <h2 id="photography-credits-heading">Photography credits:</h2>
    <ul>
      {photographyCredits.map((entry) => <li>
        {entry.person}: {entry.credit.href
          ? <a href={entry.credit.href} target="_blank" rel="noopener noreferrer">{entry.credit.text}</a>
          : entry.credit.text}
        {entry.credit.licenseHref && <> · <a href={entry.credit.licenseHref} target="_blank" rel="noopener noreferrer">{entry.credit.licenseLabel || 'CC BY 4.0'}</a></>}
        {entry.credit.note && <> ({entry.credit.note})</>}
      </li>)}
    </ul>
  </section>}
</Base>

<style>
  .workshop-page { --talk-title-size: 18px; --workshop-section-size: 24px; --speaker-photo-min: 165px; width: min(620px, calc(100% - 36px)); margin-inline: auto; }
  .workshop-page > :global(.section > .section-body) { max-width: none; }
  @media screen and (min-width: 915px) {
    /* Reserve a clear gutter for this page's wider talks and fixed utilities. */
    .workshop-page, .photography-credits { width: min(620px, calc(100% - 132px)); }
    :global(.site-footer .footer-list .footer-controls) {
      right: max(24px, calc((100% - 825px) / 2));
    }
  }
  .workshop-hero { max-width: none; padding-bottom: var(--section-space-before, 36px); }
  .workshop-hero h1 {
    margin: 0;
    max-width: 100%;
    /* Reuse Home's existing display-title scale, including its mobile steps. */
    font-size: clamp(31px, 6vw, 40px);
    line-height: 1.18;
    text-wrap: balance;
  }
  .title-phrase { white-space: nowrap; }
  .workshop-subtitle, .workshop-join-label {
    color: var(--muted);
    font: 400 24px/1.4 var(--sans);
  }
  .workshop-subtitle {
    font-size: 22px;
    margin: 18px 0 0;
    max-width: 100%;
    text-wrap: wrap;
  }
  @media (min-width: 656px) {
    .workshop-subtitle { letter-spacing: -0.005em; }
  }
  .workshop-closing-invitation { padding: 12px 0 36px; }
  .workshop-invitation { display: flex; align-items: center; gap: 18px; }
  .workshop-join-label { margin: 0; }
  .workshop-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 3px 8px;
    margin-top: 24px;
    color: var(--ink);
    font-size: 12.75px;
    font-weight: 600;
    line-height: 1.65;
  }
  .workshop-location::before { content: "· "; white-space: pre; }
  .workshop-hours { flex-basis: 100%; }
  .workshop-hero > .workshop-invitation { margin-top: 24px; }
  .interest-note { margin: 12px 0 0; max-width: 60ch; text-wrap: balance; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .conduct-link { margin: 24px 0 0; font: 700 12px/1.65 var(--sans); }
  .schedule-note { margin: 0 0 12px; color: var(--muted); font: 400 12px/1.65 var(--sans); }
  .timetable { list-style: none; margin: 0; padding: 0; }
  .timetable > .schedule-row { display: grid; grid-template-columns: 124px minmax(0, 1fr); gap: 18px; margin: 0; padding: 15px 0; border-top: 0.75px solid var(--line); }
  .session-time { color: var(--muted); font: 500 12px/1.65 var(--sans); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .session-copy { min-width: 0; }
  .session-title { margin: 0; font: 700 var(--talk-title-size)/1.3 var(--serif); letter-spacing: -0.005em; }
  .session-title a { color: inherit; text-decoration-thickness: 0.75px; text-underline-offset: 3px; }
  .session-kind { margin: 0 0 3px; color: var(--muted); font: 500 11.25px/1.5 var(--sans); }
  .session-byline, .session-participants, .session-moderator { margin: 6px 0 0; font: 400 12.75px/1.5 var(--sans); }
  .session-affiliation, .session-moderator, .working-title { color: var(--muted); }
  .schedule-pause .session-title { font: 500 12.75px/1.65 var(--sans); }
  .spotlight-program { margin: 9px 0 0; padding: 0; list-style: none; font: 400 12px/1.65 var(--sans); }
  .spotlight-program li { margin: 3px 0 0; }
  .arrival-copy { font: 400 12.75px/1.65 var(--sans); }
  .arrival-copy p { margin: 0; }
  .arrival-copy p + p { margin-top: 9px; }
  .speaker-list > li[id], .program-panels > li[id], .schedule-row[id] { scroll-margin-top: 90px; }
  .talk-title a, .talk-pending a, .program-panels h3 a, .workshop-page :global(#spotlights > .section-label a) {
    color: inherit; text-decoration: none;
  }
  .talk-title a:hover, .talk-pending a:hover, .program-panels h3 a:hover, .workshop-page :global(#spotlights > .section-label a:hover) { color: inherit; text-decoration: none; }
